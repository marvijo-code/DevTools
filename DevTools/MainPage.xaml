<Page x:Class="DevTools.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:models="using:DevTools.Models"
      xmlns:vm="using:DevTools.ViewModels"
      xmlns:infra="using:DevTools.Infrastructure"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Page.Resources>
    <infra:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <Style x:Key="QuietButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="MinWidth" Value="32" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="ColumnButtonStyle" TargetType="Button" BasedOn="{StaticResource QuietButtonStyle}">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
      <Setter Property="Padding" Value="0,4" />
    </Style>
    <DataTemplate x:Key="ProcessTableTemplate" x:DataType="models:ProcessKillSection">
      <StackPanel>
        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,1" Padding="8,0,90,0">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.3*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="82" />
            </Grid.ColumnDefinitions>
            <Button Content="{Binding ProcessColumnLabel}" Tag="Process" Click="SortProcesses_Click"
                    Style="{StaticResource ColumnButtonStyle}" AutomationProperties.AutomationId="SortProcess"
                    ToolTipService.ToolTip="Sort by process name. Click again to reverse." />
            <Button Grid.Column="1" Content="{Binding PathColumnLabel}" Tag="StartPath" Click="SortProcesses_Click"
                    Style="{StaticResource ColumnButtonStyle}" AutomationProperties.AutomationId="SortStartPath"
                    ToolTipService.ToolTip="Sort by full start path. Click again to reverse." />
            <Button Grid.Column="2" Content="{Binding MemoryColumnLabel}" Tag="Memory" Click="SortProcesses_Click"
                    Style="{StaticResource ColumnButtonStyle}" HorizontalContentAlignment="Right"
                    AutomationProperties.AutomationId="SortMemory"
                    ToolTipService.ToolTip="Sort by memory. Click again to reverse." />
          </Grid>
        </Border>
        <ItemsControl ItemsSource="{Binding Entries}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:ProcessKillEntry">
              <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                <Grid>
                  <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                          Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}" />
                  <Border Width="3" Margin="0,10" CornerRadius="2" HorizontalAlignment="Left"
                          Background="{ThemeResource SystemControlHighlightAccentBrush}"
                          Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}" />
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="82" />
                    </Grid.ColumnDefinitions>
                    <Button Click="SelectProcess_Click" Tag="{Binding}"
                            Style="{StaticResource QuietButtonStyle}" Padding="8,8"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            AutomationProperties.Name="{Binding DisplayName}"
                            AutomationProperties.AutomationId="SelectProcessDetails">
                      <Grid ColumnSpacing="12" MinHeight="36">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="1.3*" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="82" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                          <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold"
                                     TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding DisplayName}" />
                          <TextBlock Text="{Binding ProcessIdLabel}" FontSize="12"
                                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center"
                                    ToolTipService.ToolTip="{Binding StartPath}">
                          <TextBlock Text="{Binding ExecutableName}" FontSize="12" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Role}" FontSize="12" TextTrimming="CharacterEllipsis"
                                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding Usage}" FontSize="12"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                      </Grid>
                    </Button>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button Content="End" Width="50" Click="KillProcess_Click" Tag="{Binding ProcessId}"
                              Style="{StaticResource QuietButtonStyle}" IsEnabled="{Binding CanKill}"
                              AutomationProperties.Name="End process" ToolTipService.ToolTip="End this process and its subprocesses" />
                    <Button Click="ProcessActions_Click" Tag="{Binding}"
                            Style="{StaticResource QuietButtonStyle}" VerticalAlignment="Center"
                            AutomationProperties.Name="{Binding ActionsLabel}"
                            ToolTipService.ToolTip="Process actions">
                      <FontIcon Glyph="&#xE712;" FontSize="14" />
                    </Button>
                    </StackPanel>
                  </Grid>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>
    <Style x:Key="NavigationButtonStyle" TargetType="Button">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style TargetType="ListView">
      <Setter Property="HorizontalAlignment"
              Value="Stretch" />
      <Setter Property="HorizontalContentAlignment"
              Value="Stretch" />
    </Style>
    <Style TargetType="ListViewItem">
      <Setter Property="HorizontalContentAlignment"
              Value="Stretch" />
    </Style>
    <!-- Expanders read as bare buttons with the default template. Giving them a card surface, a border
         and real padding makes them look like the panels they actually are. -->
    <Style TargetType="Expander">
      <Setter Property="HorizontalAlignment"
              Value="Stretch" />
      <Setter Property="HorizontalContentAlignment"
              Value="Stretch" />
      <Setter Property="Background"
              Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
      <Setter Property="BorderBrush"
              Value="{ThemeResource CardStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness"
              Value="1" />
      <Setter Property="CornerRadius"
              Value="10" />
      <Setter Property="Padding"
              Value="14,12" />
      <Setter Property="MinHeight"
              Value="48" />
    </Style>

    <!-- Shared card surface for the right-hand context panel sections. -->
    <Style x:Key="ContextCardStyle"
           TargetType="Border">
      <Setter Property="Padding"
              Value="14" />
      <Setter Property="CornerRadius"
              Value="12" />
      <Setter Property="HorizontalAlignment"
              Value="Stretch" />
      <Setter Property="Background"
              Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
      <Setter Property="BorderBrush"
              Value="{ThemeResource CardStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness"
              Value="1" />
    </Style>

    <Style x:Key="ContextCardHeaderStyle"
           TargetType="TextBlock">
      <Setter Property="FontWeight"
              Value="SemiBold" />
      <Setter Property="FontSize"
              Value="13" />
      <Setter Property="Opacity"
              Value="0.9" />
      <Setter Property="Margin"
              Value="0,0,0,8" />
    </Style>

    <!-- Chart palette: one hue per metric so the five sparklines stay distinguishable at a glance. -->
    <SolidColorBrush x:Key="ChartCpuLineBrush"
                     Color="#4FC3F7" />
    <SolidColorBrush x:Key="ChartCpuAreaBrush"
                     Color="#4FC3F7"
                     Opacity="0.20" />
    <SolidColorBrush x:Key="ChartCommitLineBrush"
                     Color="#EF5350" />
    <SolidColorBrush x:Key="ChartCommitAreaBrush"
                     Color="#EF5350"
                     Opacity="0.20" />
    <SolidColorBrush x:Key="ChartMemoryLineBrush"
                     Color="#FFB74D" />
    <SolidColorBrush x:Key="ChartMemoryAreaBrush"
                     Color="#FFB74D"
                     Opacity="0.20" />
    <SolidColorBrush x:Key="ChartDiskLineBrush"
                     Color="#66BB6A" />
    <SolidColorBrush x:Key="ChartDiskAreaBrush"
                     Color="#66BB6A"
                     Opacity="0.20" />
    <SolidColorBrush x:Key="ChartFaultLineBrush"
                     Color="#BA68C8" />
    <SolidColorBrush x:Key="ChartFaultAreaBrush"
                     Color="#BA68C8"
                     Opacity="0.20" />
    <SolidColorBrush x:Key="ChartSpaceLineBrush"
                     Color="#4DD0E1" />
    <SolidColorBrush x:Key="ChartSpaceAreaBrush"
                     Color="#4DD0E1"
                     Opacity="0.20" />
  </Page.Resources>
  <Grid x:Name="RootLayoutGrid"
        Margin="12"
        RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0"
          ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="124" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Grid.ColumnSpan="2"
              Padding="12"
              CornerRadius="8"
              HorizontalAlignment="Stretch"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1">
        <Grid ColumnSpacing="18"
              RowSpacing="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>


          <TextBlock Text="DevTools"
                     FontSize="26"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center" />

          <TextBlock Grid.Column="1"
                     Text="Processes, system resources, workflow runs and storage."
                     Opacity="0.72"
                     MaxWidth="680"
                     VerticalAlignment="Center"
                     TextWrapping="WrapWholeWords" />


        </Grid>
      </Border>

      <Button Grid.Column="2"
              Content="Refresh Now"
              Click="RefreshNow_Click"
              MinWidth="132"
              VerticalAlignment="Stretch" />
    </Grid>

    <Grid Grid.Row="1"
          ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="124" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0"
              Padding="8"
              CornerRadius="8"
              HorizontalAlignment="Stretch"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1">
        <Grid RowSpacing="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="1"
                      Spacing="8">
            <Button Content="Resources"
                    x:Name="ResourcesNavigationButton" Style="{StaticResource NavigationButtonStyle}"
                    Click="NavigateToResources_Click" />
            <Button Content="Processes"
                    x:Name="ProcessesNavigationButton" Style="{StaticResource NavigationButtonStyle}"
                    Click="NavigateToKillProcesses_Click" />
            <Button Content="Runs"
                    x:Name="RunsNavigationButton" Style="{StaticResource NavigationButtonStyle}"
                    Click="NavigateToRuns_Click" />
            <Button Content="Open Work"
                    x:Name="OpenWorkNavigationButton" Style="{StaticResource NavigationButtonStyle}"
                    Click="NavigateToOpenWork_Click" />
            <Button Content="Worktrees"
                    x:Name="WorktreesNavigationButton" Style="{StaticResource NavigationButtonStyle}"
                    Click="NavigateToWorktrees_Click" />
            <Button Content="Storage"
                    x:Name="StorageNavigationButton" Style="{StaticResource NavigationButtonStyle}"
                    Click="NavigateToDisk_Click" />
            <Button Content="Auth"
                    Style="{StaticResource NavigationButtonStyle}"
                    Click="NavigateToRepos_Click" />
            <Button Content="Logs"
                    Style="{StaticResource NavigationButtonStyle}"
                    Click="OpenLogs_Click" />
          </StackPanel>

          <StackPanel Grid.Row="2"
                      Spacing="4">
            <TextBlock Text="{Binding RepositorySummaryText}"
                       HorizontalAlignment="Center"
                       FontWeight="SemiBold"
                       FontSize="12" />
            <TextBlock Text="{Binding VisibleRunsText}"
                       HorizontalAlignment="Center"
                       Opacity="0.72"
                       FontSize="12" />
          </StackPanel>
        </Grid>
      </Border>

      <Border x:Name="MainContentBorder"
              Grid.Column="1"
              Padding="14"
              CornerRadius="8"
              HorizontalAlignment="Stretch"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1">
        <Grid>
          <Grid x:Name="KillProcessesContentPane"
                RowSpacing="10"
                Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Spacing="4">
                <TextBlock Text="Processes" FontSize="20" FontWeight="SemiBold" />
                <Grid ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <ProgressRing Width="14" Height="14" IsActive="{Binding IsKillProcessesRefreshing}" />
                  <TextBlock Grid.Column="1" Text="{Binding KillProcessesStatusText}" FontSize="12"
                             ToolTipService.ToolTip="{Binding KillProcessesStatusText}"
                             TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
                <Button Style="{StaticResource QuietButtonStyle}" Click="RefreshKillProcesses_Click"
                        AutomationProperties.Name="Refresh processes" ToolTipService.ToolTip="Refresh processes">
                  <FontIcon Glyph="&#xE72C;" FontSize="16" />
                </Button>
                <Button Style="{StaticResource QuietButtonStyle}" AutomationProperties.Name="Process tools"
                        ToolTipService.ToolTip="Process tools">
                  <FontIcon Glyph="&#xE712;" FontSize="16" />
                  <Button.Flyout>
                    <MenuFlyout>
                      <MenuFlyoutItem Text="Connect Firefox" Click="ConnectFirefox_Click"
                                     AutomationProperties.AutomationId="ConnectFirefox" />
                      <MenuFlyoutItem Text="Open System Informer" Click="OpenSystemInformer_Click"
                                     AutomationProperties.AutomationId="OpenSystemInformer" />
                    </MenuFlyout>
                  </Button.Flyout>
                </Button>
              </StackPanel>
            </Grid>

            <TextBox x:Name="ProcessFilterBox" Grid.Row="1"
                     AutomationProperties.Name="Search processes"
                     PlaceholderText="Search processes, PID or path"
                     Text="{Binding ProcessFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <ScrollViewer x:Name="KillProcessesScroll" Grid.Row="2"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="12">
                <TextBlock Text="{Binding KillProcessesHeadline}" FontSize="12" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ItemsControl ItemsSource="{Binding KillProcessSections}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:ProcessKillSection">
                      <StackPanel Margin="0,0,0,4">
                        <Grid ColumnSpacing="4" Margin="0,0,0,4">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="32" />
                          </Grid.ColumnDefinitions>
                          <Button Click="ToggleProcessSection_Click" Tag="{Binding}"
                                  Style="{StaticResource QuietButtonStyle}"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                  ToolTipService.ToolTip="{Binding StartPath}">
                            <Grid ColumnSpacing="8">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <TextBlock Text="{Binding ExpandGlyph}" FontSize="16" VerticalAlignment="Center" />
                              <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Summary}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                              </StackPanel>
                            </Grid>
                          </Button>
                          <Button Grid.Column="1" Click="ProcessGroupActions_Click" Tag="{Binding}"
                                  Style="{StaticResource QuietButtonStyle}" VerticalAlignment="Center"
                                  AutomationProperties.Name="Group actions" ToolTipService.ToolTip="Group actions">
                            <FontIcon Glyph="&#xE712;" FontSize="14" />
                          </Button>
                        </Grid>
                        <StackPanel Margin="32,0,0,0" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                          <StackPanel Spacing="8" Visibility="{Binding HasActivitySource, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding ActivityHeading}" FontWeight="SemiBold" FontSize="14" Margin="8,4,0,0" />
                            <TextBlock Text="{Binding ActivityStatus}" FontSize="13" TextWrapping="Wrap" Margin="8,0,8,4"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button Content="Connect Firefox" Click="ConnectFirefox_Click" Margin="8,0,0,4"
                                    Visibility="{Binding IsFirefox, Converter={StaticResource BoolToVisibilityConverter}}"
                                    ToolTipService.ToolTip="Enable live tab-to-process links for End process" />
                            <ItemsControl ItemsSource="{Binding Activities}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:AppActivityEntry">
                                  <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Border Grid.ColumnSpan="2" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <Border Width="3" HorizontalAlignment="Left" Margin="0,8" Background="{ThemeResource SystemControlHighlightAccentBrush}"
                                            Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <Button Style="{StaticResource QuietButtonStyle}" Click="SelectActivity_Click" Tag="{Binding}"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12,8"
                                            AutomationProperties.Name="{Binding Title}" ToolTipService.ToolTip="{Binding Title}">
                                      <StackPanel Spacing="3">
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                      </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" Content="End" Width="50" Margin="4,0,0,0" VerticalAlignment="Center"
                                            Click="EndActivityProcess_Click" Tag="{Binding}" Style="{StaticResource QuietButtonStyle}"
                                            IsEnabled="{Binding CanEndProcess}" ToolTipService.ToolTip="{Binding EndProcessHint}"
                                            Visibility="{Binding IsFirefoxTab, Converter={StaticResource BoolToVisibilityConverter}}" />
                                  </Grid>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Expander Header="{Binding ProcessListHeading}" Padding="8" CornerRadius="4" MinHeight="36">
                              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ProcessTableTemplate}" HorizontalContentAlignment="Stretch" />
                            </Expander>
                          </StackPanel>
                          <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ProcessTableTemplate}" HorizontalContentAlignment="Stretch"
                                          Visibility="{Binding ShowPlainProcesses, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </Grid>

          <Grid x:Name="WorkflowContentPane"
                RowSpacing="10">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <StackPanel>
                <TextBlock Text="GitHub Workflow Explorer"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="Filter by repo, workflow, branch, author, PR text, SHA, and status."
                           Opacity="0.7" />
              </StackPanel>

              <ComboBox Grid.Column="1"
                        Header="Status"
                        ItemsSource="{Binding StatusFilterOptions}"
                        SelectedItem="{Binding StatusFilter, Mode=TwoWay}" />

              <Border Grid.Column="2"
                      Padding="10,5"
                      CornerRadius="8"
                      Background="{ThemeResource AccentFillColorSecondaryBrush}">
                <TextBlock Text="{Binding VisibleRunsText}"
                           FontWeight="SemiBold" />
              </Border>
            </Grid>

            <TextBox x:Name="RunFilterBox"
                     Grid.Row="1"
                     Header="Search"
                     PlaceholderText="&lt;author&gt;, PR #123, &lt;branch&gt;, &lt;repo&gt;, PR description, &lt;sha&gt;..."
                     Text="{Binding RunFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <Expander x:Name="RepositoryExpander"
                      Grid.Row="2"
                      Header="Auth, Refresh, and Repository Setup"
                      HorizontalAlignment="Stretch"
                      IsExpanded="False">
              <Border Padding="12"
                      CornerRadius="14"
                      Background="{ThemeResource LayerFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1">
                <StackPanel Spacing="8">
                  <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding StatusMessage}"
                               TextWrapping="WrapWholeWords"
                               Opacity="0.86" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding AuthMessage}"
                               TextWrapping="WrapWholeWords"
                               Opacity="0.72" />
                  </Grid>

                  <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="130" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding LastRefreshText}"
                               Opacity="0.68"
                               VerticalAlignment="Center" />

                    <ToggleSwitch Grid.Column="1"
                                  Header="Auto Refresh"
                                  IsOn="{Binding AutoRefreshEnabled, Mode=TwoWay}"
                                  OnContent="On"
                                  OffContent="Off"
                                  VerticalAlignment="Center" />

                    <ComboBox Grid.Column="2"
                              Header="Refresh Every"
                              ItemsSource="{Binding RefreshIntervalOptions}"
                              SelectedItem="{Binding RefreshIntervalSeconds, Mode=TwoWay}" />
                  </Grid>

                  <TextBlock Text="{Binding RefreshIntervalSummary}"
                             Opacity="0.68" />

                  <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="Sign In (gh)"
                            Click="GhLogin_Click" />
                    <Button Grid.Column="1"
                            Content="Use gh Token"
                            Click="UseGhToken_Click" />
                    <Button Grid.Column="2"
                            Content="Reload Auth"
                            Click="ReloadAuth_Click" />
                    <Button Grid.Column="3"
                            Content="Open Logs"
                            Click="OpenLogs_Click" />
                    <Button Grid.Column="4"
                            Content="Add Repo"
                            Click="AddRepository_Click" />
                  </Grid>

                  <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="PatInputBox"
                             Header="Personal Access Token (PAT)"
                             PlaceholderText="github_pat_..."
                             Grid.Column="0" />
                    <Button Grid.Column="1"
                            Content="Use PAT"
                            Click="UsePat_Click"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,1" />
                    <Button Grid.Column="2"
                            Content="Clear PAT"
                            Click="ClearPat_Click"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,1" />
                  </Grid>

                  <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             x:Name="OwnerInputBox"
                             Header="Owner"
                             Text="{Binding OwnerInput, Mode=TwoWay}" />
                    <TextBox Grid.Column="1"
                             Header="Repository"
                             PlaceholderText="owner/repo also works here"
                             Text="{Binding RepoInput, Mode=TwoWay}" />
                  </Grid>

                  <ListView ItemsSource="{Binding Repositories}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            MaxHeight="88"
                            SelectionMode="None">
                    <ListView.ItemTemplate>
                      <DataTemplate x:DataType="models:RepositoryDefinition">
                        <Grid ColumnSpacing="8"
                              HorizontalAlignment="Stretch"
                              Padding="0,2">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding FullName}"
                                     VerticalAlignment="Center" />
                          <Button Grid.Column="1"
                                  Content="Remove"
                                  Click="RemoveRepository_Click"
                                  Tag="{Binding}" />
                        </Grid>
                      </DataTemplate>
                    </ListView.ItemTemplate>
                  </ListView>
                </StackPanel>
              </Border>
            </Expander>

            <ListView x:Name="RunsList"
                      Grid.Row="3"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      ItemsSource="{Binding Runs}"
                      SelectedItem="{Binding SelectedRun, Mode=TwoWay}"
                      SelectionChanged="RunsList_SelectionChanged">
              <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:WorkflowRunItem">
                  <Border Padding="12"
                          Margin="0,0,0,8"
                          CornerRadius="14"
                          HorizontalAlignment="Stretch"
                          Background="{Binding StatusBackgroundBrush}"
                          BorderBrush="{Binding StatusBorderBrush}"
                          BorderThickness="1">
                    <StackPanel Spacing="7">
                      <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding Repository.FullName}"
                                   Opacity="0.72"
                                   VerticalAlignment="Center" />

                        <Border Grid.Column="1"
                                Padding="8,4"
                                CornerRadius="6"
                                Background="{Binding StatusForegroundBrush}">
                          <TextBlock Text="{Binding StatusBadgeText}"
                                     Foreground="White"
                                     FontSize="12"
                                     FontWeight="SemiBold" />
                        </Border>
                      </Grid>

                      <TextBlock Text="{Binding WorkflowName}"
                                 FontSize="17"
                                 FontWeight="SemiBold"
                                 MaxLines="1"
                                 TextTrimming="CharacterEllipsis" />

                      <StackPanel Orientation="Horizontal"
                                  Spacing="8">
                        <Border Padding="8,3"
                                CornerRadius="6"
                                Background="{Binding WorkflowTagBackgroundBrush}">
                          <TextBlock Text="{Binding WorkflowTagText}"
                                     Foreground="{Binding WorkflowTagForegroundBrush}"
                                     FontSize="11"
                                     FontWeight="SemiBold" />
                        </Border>
                        <Border Padding="8,3"
                                CornerRadius="6"
                                Background="{Binding EventTagBackgroundBrush}">
                          <TextBlock Text="{Binding EventTagText}"
                                     Foreground="{Binding EventTagForegroundBrush}"
                                     FontSize="11"
                                     FontWeight="SemiBold" />
                        </Border>
                      </StackPanel>

                      <TextBlock Text="{Binding DisplayTitle}"
                                 MaxLines="2"
                                 TextWrapping="WrapWholeWords"
                                 TextTrimming="CharacterEllipsis" />

                      <TextBlock Text="{Binding WorkflowMetaSummary}"
                                 Opacity="0.72"
                                 FontSize="12" />

                      <TextBlock Text="{Binding TimelineSummary}"
                                 Opacity="0.72"
                                 FontSize="12" />

                      <TextBlock Text="{Binding RunDescriptionPreview}"
                                 FontSize="12"
                                 Opacity="0.78"
                                 MaxLines="2"
                                 TextWrapping="WrapWholeWords"
                                 TextTrimming="CharacterEllipsis" />

                      <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                          <TextBlock Text="{Binding UiSummary}" />
                          <TextBlock Text="{Binding ActualSummary}"
                                     Opacity="0.78"
                                     FontSize="12" />
                          <StackPanel Orientation="Horizontal"
                                      Spacing="8">
                            <HyperlinkButton Content="{Binding UiShaDisplay}"
                                             Click="OpenLink_Click"
                                             Tag="{Binding DisplayedCommitUrl}" />
                            <HyperlinkButton Content="{Binding ActualShaDisplay}"
                                             Click="OpenLink_Click"
                                             Tag="{Binding ActualCommitUrl}"
                                             IsEnabled="{Binding HasActualCommitUrl}" />
                          </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="Open Run"
                                Click="OpenLink_Click"
                                Tag="{Binding RunUrl}"
                                VerticalAlignment="Center" />
                      </Grid>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
          </Grid>

          <Grid x:Name="DiskContentPane"
                RowSpacing="10"
                Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <StackPanel>
                <TextBlock Text="Disk Usage Analysis"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="{Binding DiskUsageHeadline}"
                           TextWrapping="WrapWholeWords"
                           Opacity="0.72" />
                <StackPanel Orientation="Horizontal"
                            Spacing="8">
                  <ProgressRing Width="16"
                                Height="16"
                                IsActive="{Binding IsDiskUsageRefreshing}"
                                VerticalAlignment="Center" />
                  <TextBlock Text="{Binding DiskUsageActivityText}"
                             VerticalAlignment="Center"
                             FontFamily="Consolas"
                             FontSize="12"
                             Opacity="0.74" />
                </StackPanel>
                <TextBlock Text="{Binding DiskUsageStatusText}"
                           TextWrapping="WrapWholeWords"
                           Opacity="0.62"
                           FontSize="12" />
              </StackPanel>

              <Button Grid.Column="1"
                      Content="Refresh Space Analyzer"
                      Click="RefreshDiskUsage_Click" />
            </Grid>

            <ScrollViewer x:Name="DiskScroll"
                          Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="10">
                <Border x:Name="CleanupOptionsCard"
                        Padding="12"
                        CornerRadius="10"
                        HorizontalAlignment="Stretch"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                  <StackPanel Spacing="10">
                    <Grid ColumnSpacing="10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>

                      <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8">
                          <TextBlock Text="Cleanup options"
                                     FontSize="16"
                                     FontWeight="SemiBold" />
                          <ProgressRing Width="14"
                                        Height="14"
                                        IsActive="{Binding IsCleanupRefreshing}"
                                        VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding CleanupSummary}"
                                   TextWrapping="WrapWholeWords"
                                   FontSize="12"
                                   Opacity="0.76" />
                      </StackPanel>

                      <Button Grid.Column="1"
                              Content="Check again"
                              Click="RefreshCleanupOptions_Click"
                              IsEnabled="{Binding CanRefreshCleanupOptions}"
                              VerticalAlignment="Top" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding CleanupOptions}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:CleanupOption">
                          <Border Padding="10"
                                  Margin="0,0,0,8"
                                  CornerRadius="10"
                                  HorizontalAlignment="Stretch"
                                  Background="{Binding VerdictBackgroundBrush}"
                                  BorderBrush="{Binding VerdictBorderBrush}"
                                  BorderThickness="1">
                            <Grid ColumnSpacing="12">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>

                              <Border Padding="8,3"
                                      MinWidth="76"
                                      CornerRadius="6"
                                      VerticalAlignment="Top"
                                      Background="{Binding VerdictAccentBrush}">
                                <TextBlock Text="{Binding VerdictText}"
                                           Foreground="{Binding VerdictBadgeForegroundBrush}"
                                           HorizontalAlignment="Center"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                              </Border>

                              <StackPanel Grid.Column="1"
                                          Spacing="3">
                                <TextBlock Text="{Binding Title}"
                                           FontSize="14"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Reason}"
                                           FontSize="12"
                                           Opacity="0.82"
                                           TextWrapping="WrapWholeWords" />
                                <TextBlock Text="{Binding ResultText}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextWrapping="WrapWholeWords" />
                              </StackPanel>

                              <TextBlock Grid.Column="2"
                                         Text="{Binding SizeText}"
                                         FontFamily="Consolas"
                                         FontWeight="SemiBold"
                                         VerticalAlignment="Top" />

                              <Button Grid.Column="3"
                                      Content="{Binding ActionText}"
                                      Click="RunCleanupOption_Click"
                                      Tag="{Binding}"
                                      IsEnabled="{Binding CanRun}"
                                      MinWidth="130"
                                      VerticalAlignment="Top" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <Border Padding="10,8"
                        CornerRadius="10"
                        Background="{ThemeResource AccentFillColorSecondaryBrush}"
                        Visibility="{Binding ShowElevationHint, Converter={StaticResource BoolToVisibilityConverter}}">
                  <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Not running as administrator. Folder sizes come from a low-priority folder walk. Restart as admin to read the NTFS Master File Table directly."
                               TextWrapping="WrapWholeWords"
                               VerticalAlignment="Center"
                               FontSize="12" />
                    <Button Grid.Column="1"
                            Content="Restart as Admin"
                            Click="RestartAsAdmin_Click"
                            VerticalAlignment="Center" />
                  </Grid>
                </Border>

                <Border Padding="12"
                        CornerRadius="14"
                        HorizontalAlignment="Stretch"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                  <StackPanel Spacing="4">
                    <TextBlock Text="Startup and admin rights"
                               FontSize="16"
                               FontWeight="SemiBold" />
                    <ToggleSwitch Header="Start DevTools as administrator"
                                  IsOn="{Binding RunAsAdministrator, Mode=TwoWay}"
                                  OnContent="On (fast NTFS folder scans)"
                                  OffContent="Off (slower folder scans)" />
                    <TextBlock Text="{Binding ElevationPreferenceText}"
                               TextWrapping="WrapWholeWords"
                               FontSize="12"
                               Opacity="0.72" />
                    <TextBlock Text="Administrator rights are the default because the fast folder scan needs them. The choice applies the next time you open DevTools from the Start menu. Use the 'DevTools (no admin)' shortcut to skip admin rights for one launch without changing this setting."
                               TextWrapping="WrapWholeWords"
                               FontSize="11"
                               Opacity="0.6" />
                  </StackPanel>
                </Border>

                <Border Padding="12"
                        CornerRadius="14"
                        HorizontalAlignment="Stretch"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Bulk Cleanup"
                               FontSize="16"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding BulkCleanupHeadline}"
                               TextWrapping="WrapWholeWords"
                               Opacity="0.72"
                               FontSize="12" />

                    <Grid ColumnSpacing="8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Button Grid.Column="0"
                              Content="{Binding BulkCleanupButtonText}"
                              Click="BulkCleanup_Click"
                              IsEnabled="{Binding IsBulkCleanupAvailable}"
                              VerticalAlignment="Center" />
                      <Button Grid.Column="1"
                              Content="Cancel"
                              Click="CancelBulkCleanup_Click"
                              IsEnabled="{Binding IsBulkCleanupRunning}"
                              VerticalAlignment="Center" />
                      <ProgressRing Grid.Column="2"
                                    Width="16"
                                    Height="16"
                                    HorizontalAlignment="Left"
                                    IsActive="{Binding IsBulkCleanupRunning}"
                                    VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Text="{Binding BulkCleanupStatusText}"
                               TextWrapping="WrapWholeWords"
                               FontFamily="Consolas"
                               FontSize="12"
                               Opacity="0.8" />
                    <TextBlock Text="{Binding BulkCleanupAvailabilityText}"
                               TextWrapping="WrapWholeWords"
                               FontSize="11"
                               Opacity="0.6" />

                    <Expander Header="Cleanup report"
                              HorizontalAlignment="Stretch"
                              Visibility="{Binding HasBulkCleanupReport, Converter={StaticResource BoolToVisibilityConverter}}">
                      <ScrollViewer MaxHeight="260"
                                    VerticalScrollBarVisibility="Auto"
                                    HorizontalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding BulkCleanupReportText}"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   TextWrapping="NoWrap"
                                   IsTextSelectionEnabled="True" />
                      </ScrollViewer>
                    </Expander>
                  </StackPanel>
                </Border>

                <TextBlock Text="{Binding DiskUsageAnalysis}"
                           TextWrapping="WrapWholeWords"
                           Opacity="0.82" />

                <Border x:Name="FolderBrowserCard"
                        Padding="12"
                        CornerRadius="14"
                        HorizontalAlignment="Stretch"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Folder Browser (all drives)"
                               FontSize="16"
                               FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding FolderBrowserDrives}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal"
                                      Spacing="6" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                          <Button Content="{Binding}"
                                  Tag="{Binding}"
                                  Click="BrowseDrive_Click"
                                  Padding="10,2"
                                  ToolTipService.ToolTip="Open this drive in the folder browser" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid ColumnSpacing="8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Button Content="Up"
                              Click="BrowseUp_Click"
                              IsEnabled="{Binding CanFolderBrowserGoUp}"
                              VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding FolderBrowserPath}"
                                 FontFamily="Consolas"
                                 VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis"
                                 IsTextSelectionEnabled="True" />
                      <Button Grid.Column="2"
                              Content="Open in Explorer"
                              Click="OpenPath_Click"
                              Tag="{Binding FolderBrowserPath}"
                              VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="{Binding FolderBrowserSummary}"
                               TextWrapping="WrapWholeWords"
                               FontSize="12"
                               Opacity="0.72" />
                    <ScrollViewer MaxHeight="420"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                      <ItemsControl ItemsSource="{Binding FolderBrowserRows}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:FolderBrowserRow">
                            <Grid ColumnSpacing="10"
                                  Margin="0,0,0,4">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="90" />
                              </Grid.ColumnDefinitions>
                              <Grid Margin="{Binding Indent}"
                                    ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="24" />
                                  <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Tag="{Binding Path}"
                                        Click="ToggleFolderRow_Click"
                                        Visibility="{Binding ExpandVisibility}"
                                        Padding="0"
                                        Width="24"
                                        Height="24"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        ToolTipService.ToolTip="Expand or collapse this folder">
                                  <FontIcon Glyph="{Binding ExpandGlyph}"
                                            FontSize="11" />
                                </Button>
                                <StackPanel Grid.Column="1">
                                  <HyperlinkButton Content="{Binding Name}"
                                                   Tag="{Binding Path}"
                                                   IsEnabled="{Binding CanOpen}"
                                                   Click="BrowseFolder_Click"
                                                   Padding="0"
                                                   FontSize="13"
                                                   ToolTipService.ToolTip="{Binding Path}" />
                                  <TextBlock Text="{Binding DetailText}"
                                             FontFamily="Consolas"
                                             FontSize="11"
                                             Opacity="0.66" />
                                </StackPanel>
                              </Grid>
                              <ProgressBar Grid.Column="1"
                                           Value="{Binding SharePercent}"
                                           Maximum="100"
                                           VerticalAlignment="Center" />
                              <TextBlock Grid.Column="2"
                                         Text="{Binding SizeText}"
                                         FontWeight="SemiBold"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Center" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding DiskUsageSections}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:DiskUsageSection">
                      <Expander Header="{Binding Title}"
                                HorizontalAlignment="Stretch"
                                IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                        <Border Padding="10"
                                Margin="0,0,0,8"
                                CornerRadius="14"
                                HorizontalAlignment="Stretch"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                          <StackPanel Spacing="8">
                            <TextBlock Text="{Binding Summary}"
                                       TextWrapping="WrapWholeWords"
                                       Opacity="0.76"
                                       FontSize="12" />

                            <ItemsControl ItemsSource="{Binding Entries}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:DiskUsageEntry">
                                  <StackPanel Margin="0,0,0,6">
                                    <Grid ColumnSpacing="10"
                                          HorizontalAlignment="Stretch">
                                      <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                      </Grid.ColumnDefinitions>

                                      <Button Grid.Column="0"
                                              Content="{Binding ExpandGlyph}"
                                              Click="ToggleDiskEntry_Click"
                                              Tag="{Binding}"
                                              MinWidth="32"
                                              Padding="8,2"
                                              FontFamily="Consolas"
                                              FontWeight="SemiBold"
                                              VerticalAlignment="Top"
                                              Visibility="{Binding CanExpand, Converter={StaticResource BoolToVisibilityConverter}}"
                                              ToolTipService.ToolTip="Expand or collapse the largest children" />

                                      <StackPanel Grid.Column="1">
                                        <HyperlinkButton Content="{Binding DisplayName}"
                                                         Click="OpenPath_Click"
                                                         Tag="{Binding Path}"
                                                         HorizontalAlignment="Left"
                                                         FontSize="13" />
                                        <TextBlock Text="{Binding Note}"
                                                   FontFamily="Consolas"
                                                   FontSize="11"
                                                   Opacity="0.66"
                                                   TextWrapping="WrapWholeWords" />
                                      </StackPanel>

                                      <TextBlock Grid.Column="2"
                                                 Text="{Binding Usage}"
                                                 VerticalAlignment="Top"
                                                 FontWeight="SemiBold"
                                                 Margin="10,0,0,0" />
                                      <Button Grid.Column="3"
                                              Content="Clear Folder"
                                              Click="ClearFolder_Click"
                                              Tag="{Binding Path}"
                                              IsEnabled="{Binding CanClear}"
                                              Margin="10,0,0,0"
                                              VerticalAlignment="Top" />
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding FlatChildren}"
                                                  Margin="42,4,0,0"
                                                  Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                                      <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:DiskUsageEntry">
                                          <Grid HorizontalAlignment="Stretch"
                                                Margin="0,0,0,4">
                                           <Grid.ColumnDefinitions>
                                             <ColumnDefinition Width="Auto" />
                                             <ColumnDefinition Width="*" />
                                           </Grid.ColumnDefinitions>
                                           <Border Width="{Binding IndentPixels}" />
                                          <Grid Grid.Column="1"
                                                ColumnSpacing="10"
                                                HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                              <ColumnDefinition Width="32" />
                                              <ColumnDefinition Width="*" />
                                              <ColumnDefinition Width="Auto" />
                                              <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Button Content="{Binding ExpandGlyph}"
                                                    Click="ToggleDiskEntry_Click"
                                                    Tag="{Binding}"
                                                    MinWidth="28"
                                                    Padding="6,0"
                                                    FontFamily="Consolas"
                                                    FontWeight="SemiBold"
                                                    VerticalAlignment="Top"
                                                    Visibility="{Binding CanExpand, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    ToolTipService.ToolTip="Expand or collapse this folder" />

                                            <StackPanel Grid.Column="1">
                                              <HyperlinkButton Content="{Binding DisplayName}"
                                                               Click="OpenPath_Click"
                                                               Tag="{Binding Path}"
                                                               HorizontalAlignment="Left"
                                                               FontSize="12" />
                                              <TextBlock Text="{Binding Note}"
                                                         FontFamily="Consolas"
                                                         FontSize="10"
                                                         Opacity="0.6"
                                                         TextWrapping="WrapWholeWords" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Usage}"
                                                       VerticalAlignment="Top"
                                                       FontWeight="SemiBold"
                                                       FontSize="12"
                                                       Margin="10,0,0,0" />
                                            <Button Grid.Column="3"
                                                    Content="Clear Folder"
                                                    Click="ClearFolder_Click"
                                                    Tag="{Binding Path}"
                                                    IsEnabled="{Binding CanClear}"
                                                    Margin="10,0,0,0"
                                                    VerticalAlignment="Top" />
                                          </Grid>
                                          </Grid>
                                        </DataTemplate>
                                      </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                  </StackPanel>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </Border>
                      </Expander>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Padding="12"
                        CornerRadius="14"
                        HorizontalAlignment="Stretch"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Biggest Files"
                               FontSize="16"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding BiggestFilesHeadline}"
                               TextWrapping="WrapWholeWords"
                               Opacity="0.72"
                               FontSize="12" />

                    <Grid ColumnSpacing="8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBox Grid.Column="0"
                               Header="Scan root or folder"
                               Text="{Binding BiggestFilesScanRoot, Mode=TwoWay}" />
                      <Button Grid.Column="1"
                              Content="C:\"
                              Click="SetBiggestFilesRootSystem_Click"
                              VerticalAlignment="Bottom" />
                      <Button Grid.Column="2"
                              Content="C:\dev"
                              Click="SetBiggestFilesRootDev_Click"
                              VerticalAlignment="Bottom" />
                    </Grid>

                    <Grid ColumnSpacing="8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <ComboBox Grid.Column="0"
                                Header="Top"
                                MinWidth="88"
                                ItemsSource="{Binding BiggestFilesTopCountOptions}"
                                SelectedItem="{Binding BiggestFilesTopCount, Mode=TwoWay}" />
                      <TextBox Grid.Column="1"
                               Header="Search"
                               PlaceholderText="name, folder, path..."
                               Text="{Binding BiggestFilesFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                      <Button Grid.Column="2"
                              Content="Scan"
                              Click="StartBiggestFilesScan_Click"
                              VerticalAlignment="Bottom" />
                      <Button Grid.Column="3"
                              Content="Cancel"
                              Click="CancelBiggestFilesScan_Click"
                              IsEnabled="{Binding IsBiggestFilesScanning}"
                              VerticalAlignment="Bottom" />
                    </Grid>

                    <Grid ColumnSpacing="10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Orientation="Horizontal"
                                  Spacing="8">
                        <ProgressRing Width="16"
                                      Height="16"
                                      IsActive="{Binding IsBiggestFilesScanning}"
                                      VerticalAlignment="Center" />
                        <TextBlock Text="{Binding BiggestFilesStatusText}"
                                   VerticalAlignment="Center"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   Opacity="0.74"
                                   TextWrapping="WrapWholeWords" />
                      </StackPanel>
                      <Border Grid.Column="1"
                              Padding="10,5"
                              CornerRadius="8"
                              VerticalAlignment="Center"
                              Background="{ThemeResource AccentFillColorSecondaryBrush}">
                        <TextBlock Text="{Binding VisibleBiggestFilesText}"
                                   FontWeight="SemiBold" />
                      </Border>
                    </Grid>

                    <ListView ItemsSource="{Binding BiggestFiles}"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              MaxHeight="460"
                              SelectionMode="None">
                      <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:BiggestFileEntry">
                          <Grid ColumnSpacing="10"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                              <HyperlinkButton Content="{Binding FileName}"
                                               Click="RevealBiggestFile_Click"
                                               Tag="{Binding Path}"
                                               HorizontalAlignment="Left"
                                               FontSize="13" />
                              <TextBlock Text="{Binding DirectoryPath}"
                                         FontFamily="Consolas"
                                         FontSize="11"
                                         Opacity="0.6"
                                         TextWrapping="WrapWholeWords" />
                              <TextBlock Text="{Binding Note}"
                                         FontSize="11"
                                         Opacity="0.66" />
                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding Usage}"
                                       VerticalAlignment="Top"
                                       FontWeight="SemiBold"
                                       Margin="10,6,0,0" />
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        VerticalAlignment="Top"
                                        Margin="10,2,0,0">
                              <Button Content="Copy"
                                      Click="CopyBiggestFilePath_Click"
                                      Tag="{Binding}" />
                              <Button Content="Delete"
                                      Click="DeleteBiggestFile_Click"
                                      Tag="{Binding}" />
                            </StackPanel>
                          </Grid>
                        </DataTemplate>
                      </ListView.ItemTemplate>
                    </ListView>
                  </StackPanel>
                </Border>

              </StackPanel>
            </ScrollViewer>
          </Grid>

          <Grid x:Name="ResourcesContentPane"
                RowSpacing="10"
                Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <StackPanel>
                <TextBlock Text="Resource Monitor"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="{Binding ResourceVerdictText}"
                           TextWrapping="WrapWholeWords"
                           Opacity="0.86" />
                <TextBlock Text="{Binding ResourceCountsText}"
                           FontFamily="Consolas"
                           FontSize="12"
                           Opacity="0.72" />
                <TextBlock Text="{Binding ResourceStatusText}"
                           FontFamily="Consolas"
                           FontSize="12"
                           Opacity="0.62" />
              </StackPanel>

              <StackPanel Grid.Column="1"
                          Spacing="6">
                <ToggleSwitch Header="Monitoring"
                              OnContent="Recording"
                              OffContent="Paused"
                              IsOn="{Binding ResourceMonitoringEnabled, Mode=TwoWay}" />
                <ComboBox Header="Sample every (s)"
                          MinWidth="130"
                          ItemsSource="{Binding ResourceIntervalOptions}"
                          SelectedItem="{Binding ResourceIntervalSeconds, Mode=TwoWay}" />
                <Button Content="Clear History"
                        HorizontalAlignment="Stretch"
                        Click="ClearResourceHistory_Click" />
              </StackPanel>
            </Grid>

            <TextBlock Grid.Row="1"
                       Text="{Binding ResourceWindowText}"
                       FontFamily="Consolas"
                       FontSize="12"
                       Opacity="0.62" />

            <ScrollViewer x:Name="ResourcesScroll"
                          Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="10">

                <!-- Metric history. Oldest sample on the left, newest on the right. -->
                <Border Padding="12"
                        CornerRadius="14"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                  <StackPanel Spacing="12">
                    <TextBlock Text="Usage over time"
                               FontWeight="SemiBold" />

                    <StackPanel Spacing="4">
                      <Grid>
                        <TextBlock Text="CPU"
                                   FontWeight="SemiBold"
                                   FontSize="13" />
                        <TextBlock Text="{Binding CpuValueText}"
                                   HorizontalAlignment="Right"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   Opacity="0.82" />
                      </Grid>
                      <infra:SparklineChart Height="52"
                                            Maximum="100"
                                            Values="{Binding CpuSeries}"
                                            LineBrush="{StaticResource ChartCpuLineBrush}"
                                            AreaBrush="{StaticResource ChartCpuAreaBrush}" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                      <Grid>
                        <TextBlock Text="Committed memory (% of commit limit)"
                                   FontWeight="SemiBold"
                                   FontSize="13" />
                        <TextBlock Text="{Binding CommitValueText}"
                                   HorizontalAlignment="Right"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   Opacity="0.82" />
                      </Grid>
                      <infra:SparklineChart Height="52"
                                            Maximum="100"
                                            Values="{Binding CommitSeries}"
                                            LineBrush="{StaticResource ChartCommitLineBrush}"
                                            AreaBrush="{StaticResource ChartCommitAreaBrush}" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                      <Grid>
                        <TextBlock Text="Physical RAM in use"
                                   FontWeight="SemiBold"
                                   FontSize="13" />
                        <TextBlock Text="{Binding MemoryValueText}"
                                   HorizontalAlignment="Right"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   Opacity="0.82" />
                      </Grid>
                      <infra:SparklineChart Height="52"
                                            Maximum="100"
                                            Values="{Binding MemorySeries}"
                                            LineBrush="{StaticResource ChartMemoryLineBrush}"
                                            AreaBrush="{StaticResource ChartMemoryAreaBrush}" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                      <Grid>
                        <TextBlock Text="Disk throughput (MB/s)"
                                   FontWeight="SemiBold"
                                   FontSize="13" />
                        <TextBlock Text="{Binding DiskValueText}"
                                   HorizontalAlignment="Right"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   Opacity="0.82" />
                      </Grid>
                      <infra:SparklineChart Height="52"
                                            Maximum="20"
                                            Values="{Binding DiskSeries}"
                                            LineBrush="{StaticResource ChartDiskLineBrush}"
                                            AreaBrush="{StaticResource ChartDiskAreaBrush}" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                      <Grid>
                        <TextBlock Text="Hard page faults per second (paging pressure)"
                                   FontWeight="SemiBold"
                                   FontSize="13" />
                        <TextBlock Text="{Binding HardFaultValueText}"
                                   HorizontalAlignment="Right"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   Opacity="0.82" />
                      </Grid>
                      <infra:SparklineChart Height="52"
                                            Maximum="200"
                                            Values="{Binding HardFaultSeries}"
                                            LineBrush="{StaticResource ChartFaultLineBrush}"
                                            AreaBrush="{StaticResource ChartFaultAreaBrush}" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                      <Grid>
                        <TextBlock Text="Free disk space on the system volume (GB)"
                                   FontWeight="SemiBold"
                                   FontSize="13" />
                        <TextBlock Text="{Binding DiskFreeValueText}"
                                   HorizontalAlignment="Right"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   Opacity="0.82" />
                      </Grid>
                      <infra:SparklineChart Height="52"
                                            AutoScaleToRange="True"
                                            Values="{Binding DiskFreeSeries}"
                                            LineBrush="{StaticResource ChartSpaceLineBrush}"
                                            AreaBrush="{StaticResource ChartSpaceAreaBrush}" />
                    </StackPanel>
                  </StackPanel>
                </Border>

                <!-- Free space per fixed volume. -->
                <Border Padding="12"
                        CornerRadius="14"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Disk space by volume"
                               FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding ResourceVolumes}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Margin="0,0,0,8"
                                      Spacing="2">
                            <TextBlock Text="{Binding HeadlineText}"
                                       FontWeight="SemiBold"
                                       FontSize="13" />
                            <ProgressBar Value="{Binding UsedPercent}"
                                         Maximum="100"
                                         Height="6" />
                            <TextBlock Text="{Binding DetailText}"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       Opacity="0.70" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <!-- Agent sessions: one row per developer process tree, expandable to its members. -->
                <Border Padding="12"
                        CornerRadius="14"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Agent sessions"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding AgentSessionSummaryText}"
                               FontFamily="Consolas"
                               FontSize="11"
                               Opacity="0.70" />
                    <ItemsControl ItemsSource="{Binding AgentSessions}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Margin="0,0,0,8"
                                  Padding="10"
                                  CornerRadius="10"
                                  Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                            <StackPanel Spacing="4">
                              <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="Auto" />
                                  <ColumnDefinition Width="*" />
                                  <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button Content="{Binding ExpandGlyph}"
                                        MinWidth="34"
                                        VerticalAlignment="Top"
                                        Tag="{Binding}"
                                        Click="ToggleAgentSession_Click" />

                                <StackPanel Grid.Column="1"
                                            Spacing="2">
                                  <TextBlock Text="{Binding HeadlineText}"
                                             FontWeight="SemiBold"
                                             FontSize="14"
                                             TextWrapping="WrapWholeWords" />
                                  <TextBlock Text="{Binding SubtitleText}"
                                             FontSize="12"
                                             Opacity="0.80"
                                             TextWrapping="WrapWholeWords" />
                                  <ProgressBar Value="{Binding SharePercent}"
                                               Maximum="100"
                                               Height="6" />
                                  <TextBlock Text="{Binding DetailText}"
                                             FontFamily="Consolas"
                                             FontSize="11"
                                             Opacity="0.70"
                                             TextWrapping="WrapWholeWords" />
                                  <TextBlock Text="{Binding WorkspaceText}"
                                             FontFamily="Consolas"
                                             FontSize="11"
                                             Opacity="0.55"
                                             TextWrapping="WrapWholeWords" />
                                </StackPanel>

                                <Button Grid.Column="2"
                                        Content="Kill Session"
                                        VerticalAlignment="Top"
                                        Tag="{Binding RootProcessId}"
                                        Click="KillProcess_Click" />
                              </Grid>

                              <ItemsControl ItemsSource="{Binding Members}"
                                            Margin="42,4,0,0"
                                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <Grid Margin="0,0,0,6"
                                          ColumnSpacing="10">
                                      <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                      </Grid.ColumnDefinitions>

                                      <StackPanel Spacing="1">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding DetailText}"
                                                   FontFamily="Consolas"
                                                   FontSize="10"
                                                   Opacity="0.65"
                                                   TextWrapping="WrapWholeWords" />
                                      </StackPanel>

                                      <Button Grid.Column="1"
                                              Content="Kill"
                                              VerticalAlignment="Top"
                                              Tag="{Binding ProcessId}"
                                              Click="KillProcess_Click" />
                                    </Grid>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <!-- Optimization findings derived from the sampled window. -->
                <Border Padding="12"
                        CornerRadius="14"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                  <StackPanel Spacing="8">
                    <TextBlock Text="What to fix"
                               FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding ResourceAdvice}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Margin="0,0,0,8"
                                  Padding="10"
                                  CornerRadius="10"
                                  Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                            <StackPanel Spacing="3">
                              <StackPanel Orientation="Horizontal"
                                          Spacing="8">
                                <Border Padding="6,1"
                                        CornerRadius="6"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                                  <TextBlock Text="{Binding SeverityLabel}"
                                             FontSize="10"
                                             FontWeight="Bold"
                                             Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>
                                <TextBlock Text="{Binding Title}"
                                           FontWeight="SemiBold"
                                           TextWrapping="WrapWholeWords"
                                           VerticalAlignment="Center" />
                              </StackPanel>
                              <TextBlock Text="{Binding Detail}"
                                         TextWrapping="WrapWholeWords"
                                         FontSize="12"
                                         Opacity="0.78" />
                              <TextBlock Text="{Binding Action}"
                                         TextWrapping="WrapWholeWords"
                                         FontSize="12"
                                         FontWeight="SemiBold"
                                         Opacity="0.92" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <!-- Where committed memory is going, grouped by kind of work. -->
                <Border Padding="12"
                        CornerRadius="14"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Where it is going (by workload)"
                               FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding ResourceWorkloads}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Margin="0,0,0,8"
                                      Spacing="2">
                            <TextBlock Text="{Binding HeadlineText}"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       TextWrapping="WrapWholeWords" />
                            <ProgressBar Value="{Binding SharePercent}"
                                         Maximum="100"
                                         Height="6" />
                            <TextBlock Text="{Binding DetailText}"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       Opacity="0.70"
                                       TextWrapping="WrapWholeWords" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <!-- Individual offenders, ranked by commit rather than working set. -->
                <Border Padding="12"
                        CornerRadius="14"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Top processes by committed memory"
                               FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding ResourceTopProcesses}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid Margin="0,0,0,8"
                                ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="2">
                              <TextBlock Text="{Binding Title}"
                                         FontWeight="SemiBold"
                                         FontSize="13" />
                              <ProgressBar Value="{Binding SharePercent}"
                                           Maximum="100"
                                           Height="6" />
                              <TextBlock Text="{Binding DetailText}"
                                         FontFamily="Consolas"
                                         FontSize="11"
                                         Opacity="0.70"
                                         TextWrapping="WrapWholeWords" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="Kill"
                                    VerticalAlignment="Top"
                                    Tag="{Binding ProcessId}"
                                    Click="KillProcess_Click" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Grid>

          <Grid x:Name="OpenWorkContentPane"
                RowSpacing="10"
                Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <StackPanel>
                <TextBlock Text="Open Work"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="Your open pull requests. Approved PRs first, then oldest first."
                           TextWrapping="WrapWholeWords"
                           Opacity="0.7" />
                <StackPanel Orientation="Horizontal"
                            Spacing="8">
                  <ProgressRing Width="16"
                                Height="16"
                                IsActive="{Binding IsOpenWorkRefreshing}"
                                VerticalAlignment="Center" />
                  <TextBlock Text="{Binding OpenWorkStatusText}"
                             VerticalAlignment="Center"
                             FontSize="12"
                             Opacity="0.62" />
                </StackPanel>
              </StackPanel>

              <Button Grid.Column="1"
                      Content="Refresh Open Work"
                      Click="RefreshOpenWork_Click"
                      VerticalAlignment="Top" />
            </Grid>

            <ScrollViewer x:Name="OpenWorkScroll"
                          Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="14">
                <StackPanel Spacing="6">
                  <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Pull Requests"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Border Grid.Column="1"
                            Padding="8,3"
                            CornerRadius="6"
                            Background="{ThemeResource AccentFillColorSecondaryBrush}">
                      <TextBlock Text="{Binding OpenWorkPullRequestSummary}"
                                 FontSize="12"
                                 FontWeight="SemiBold" />
                    </Border>
                  </Grid>

                  <TextBlock Text="Review state comes from each reviewer's latest review, so a PR with a human approval and no open change request counts as approved even when branch protection still wants another sign-off. Bot reviews are ignored."
                             TextWrapping="WrapWholeWords"
                             Opacity="0.62"
                             FontSize="12" />

                  <ItemsControl ItemsSource="{Binding OpenPullRequests}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:OpenPullRequestItem">
                        <Border Padding="12"
                                Margin="0,0,0,8"
                                CornerRadius="14"
                                HorizontalAlignment="Stretch"
                                Background="{Binding ReviewBackgroundBrush}"
                                BorderBrush="{Binding ReviewBorderBrush}"
                                BorderThickness="1">
                          <StackPanel Spacing="6">
                            <Grid ColumnSpacing="10">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>

                              <Border Padding="7,3"
                                      CornerRadius="6"
                                      VerticalAlignment="Center"
                                      Background="{Binding ReviewAccentBrush}">
                                <TextBlock Text="{Binding AgeDisplay}"
                                           Foreground="{Binding ReviewBadgeForegroundBrush}"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                              </Border>

                              <TextBlock Grid.Column="1"
                                         Text="{Binding Reference}"
                                         FontFamily="Consolas"
                                         FontSize="12"
                                         Opacity="0.78"
                                         VerticalAlignment="Center" />

                              <Border Grid.Column="2"
                                      Padding="8,3"
                                      CornerRadius="6"
                                      Background="{Binding ReviewAccentBrush}">
                                <TextBlock Text="{Binding ReviewBadgeText}"
                                           Foreground="{Binding ReviewBadgeForegroundBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                              </Border>
                            </Grid>

                            <TextBlock Text="{Binding Title}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       MaxLines="2"
                                       TextWrapping="WrapWholeWords"
                                       TextTrimming="CharacterEllipsis" />

                            <TextBlock Text="{Binding OpenedSummary}"
                                       Opacity="0.72"
                                       FontSize="12" />

                            <TextBlock Text="{Binding ReviewerSummary}"
                                       Opacity="0.72"
                                       FontSize="12"
                                       TextWrapping="WrapWholeWords" />

                            <Grid ColumnSpacing="8">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>

                              <Button Grid.Column="1"
                                      Content="Open PR"
                                      Click="OpenLink_Click"
                                      Tag="{Binding HtmlUrl}" />
                            </Grid>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

              </StackPanel>
            </ScrollViewer>
          </Grid>

          <Grid x:Name="WorktreesContentPane"
                RowSpacing="10"
                Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <StackPanel>
                <TextBlock Text="Worktrees"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="{Binding WorktreeHeadline}"
                           TextWrapping="WrapWholeWords"
                           Opacity="0.72" />
                <Grid ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <ProgressRing Width="16"
                                Height="16"
                                IsActive="{Binding IsWorktreeRefreshing}"
                                VerticalAlignment="Top" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding WorktreeStatusText}"
                             TextWrapping="WrapWholeWords"
                             FontSize="12"
                             Opacity="0.62" />
                </Grid>
              </StackPanel>

              <Button Grid.Column="1"
                      Content="Prune Missing"
                      Click="PruneWorktrees_Click"
                      VerticalAlignment="Top" />
              <Button Grid.Column="2"
                      Content="Refresh Worktrees"
                      Click="RefreshWorktrees_Click"
                      VerticalAlignment="Top" />
            </Grid>

            <Grid Grid.Row="1"
                  ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <TextBox Header="Search"
                       PlaceholderText="&lt;repo&gt;, &lt;branch&gt;, &lt;path&gt;..."
                       Text="{Binding WorktreeSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              <ComboBox Grid.Column="1"
                        Header="Show"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding WorktreeFilterOptions}"
                        SelectedItem="{Binding WorktreeFilter, Mode=TwoWay}" />
              <ComboBox Grid.Column="2"
                        Header="Sort by"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding WorktreeSortOptions}"
                        SelectedItem="{Binding WorktreeSort, Mode=TwoWay}" />
              <Border Grid.Column="3"
                      Padding="10,5"
                      CornerRadius="8"
                      VerticalAlignment="Bottom"
                      Background="{ThemeResource AccentFillColorSecondaryBrush}">
                <TextBlock Text="{Binding VisibleWorktreesText}"
                           FontWeight="SemiBold" />
              </Border>
            </Grid>

            <Grid Grid.Row="2"
                  ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <ScrollViewer VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="6">
                  <TextBlock Text="Repositories"
                             FontSize="12"
                             FontWeight="SemiBold"
                             Opacity="0.72" />
                  <ItemsControl ItemsSource="{Binding WorktreeRepositories}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:WorktreeRepositoryFilter">
                        <Button Click="WorktreeRepository_Click"
                                Tag="{Binding}"
                                Margin="0,0,0,6"
                                Padding="10,8"
                                CornerRadius="10"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Background="{Binding BackgroundBrush}"
                                BorderBrush="{Binding BorderBrush}"
                                BorderThickness="1">
                          <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Name}"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Summary}"
                                       FontSize="11"
                                       Opacity="0.78"
                                       TextWrapping="WrapWholeWords" />
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ScrollViewer>

              <ScrollViewer x:Name="WorktreesScroll"
                            Grid.Column="1"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="6">
                  <TextBlock Text="Green rows are merged with no uncommitted files, so removing them loses nothing. Removing a worktree deletes its folder only: the branch and its commits always stay. A row with uncommitted files needs Force Remove, and the confirmation says what would be lost."
                             TextWrapping="WrapWholeWords"
                             Opacity="0.62"
                             FontSize="12" />

                  <ItemsControl ItemsSource="{Binding Worktrees}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:WorktreeItem">
                        <Border Padding="12"
                                Margin="0,0,0,8"
                                CornerRadius="14"
                                HorizontalAlignment="Stretch"
                                Background="{Binding StateBackgroundBrush}"
                                BorderBrush="{Binding StateBorderBrush}"
                                BorderThickness="1">
                          <StackPanel Spacing="6">
                            <Grid ColumnSpacing="10">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>

                              <Border Padding="7,3"
                                      CornerRadius="6"
                                      VerticalAlignment="Center"
                                      Background="{Binding StateAccentBrush}">
                                <TextBlock Text="{Binding SizeDisplay}"
                                           Foreground="{Binding StateBadgeForegroundBrush}"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                              </Border>

                              <TextBlock Grid.Column="1"
                                         Text="{Binding RepositoryName}"
                                         FontFamily="Consolas"
                                         FontSize="12"
                                         Opacity="0.78"
                                         VerticalAlignment="Center" />

                              <Border Grid.Column="2"
                                      Padding="8,3"
                                      CornerRadius="6"
                                      Background="{Binding StateAccentBrush}">
                                <TextBlock Text="{Binding StateBadgeText}"
                                           Foreground="{Binding StateBadgeForegroundBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                              </Border>
                            </Grid>

                            <TextBlock Text="{Binding BranchDisplay}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       MaxLines="1"
                                       TextTrimming="CharacterEllipsis" />

                            <HyperlinkButton Content="{Binding Path}"
                                             Click="OpenPath_Click"
                                             Tag="{Binding Path}"
                                             HorizontalAlignment="Left"
                                             Padding="0"
                                             FontFamily="Consolas"
                                             FontSize="12" />

                            <TextBlock Text="{Binding Reason}"
                                       FontSize="12"
                                       Opacity="0.82"
                                       TextWrapping="WrapWholeWords" />

                            <Grid ColumnSpacing="8">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>

                              <TextBlock Text="{Binding DetailSummary}"
                                         FontSize="12"
                                         Opacity="0.68"
                                         VerticalAlignment="Center"
                                         TextWrapping="WrapWholeWords" />
                              <HyperlinkButton Grid.Column="1"
                                               Content="{Binding PullRequestButtonText}"
                                               Click="OpenLink_Click"
                                               Tag="{Binding PullRequestUrl}"
                                               IsEnabled="{Binding HasPullRequest}" />
                              <Button Grid.Column="2"
                                      Content="{Binding RemoveButtonText}"
                                      Click="RemoveWorktree_Click"
                                      Tag="{Binding}"
                                      IsEnabled="{Binding CanRemove}"
                                      MinWidth="110" />
                            </Grid>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ScrollViewer>
            </Grid>
          </Grid>
        </Grid>
      </Border>

      <Border x:Name="RunDetailsBorder"
              Grid.Column="2"
              Padding="14"
              CornerRadius="8"
              HorizontalAlignment="Stretch"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1">
        <Grid RowSpacing="10">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="DetailsPane"
                        HorizontalAlignment="Stretch">
              <TextBlock Text="{Binding ContextPaneTitle}"
                         FontSize="20"
                         FontWeight="SemiBold" />
              <TextBlock Text="{Binding ContextPaneSubtitle}"
                         Opacity="0.72"
                         TextWrapping="WrapWholeWords" />
            </StackPanel>

            <Border x:Name="RunStatusBadge"
                    Grid.Column="1"
                    Padding="8,4"
                    CornerRadius="6"
                    VerticalAlignment="Top"
                    Background="{Binding SelectedRun.StatusForegroundBrush}">
              <TextBlock Text="{Binding SelectedRun.StatusBadgeText}"
                         Foreground="White"
                         FontWeight="SemiBold" />
            </Border>
          </Grid>

          <ScrollViewer x:Name="DetailsScroll"
                        Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="10"
                        Visibility="{Binding HasSelectedRun, Converter={StaticResource BoolToVisibilityConverter}}"
                        HorizontalAlignment="Stretch">
              <StackPanel Spacing="4"
                          HorizontalAlignment="Stretch">
                <TextBlock Text="{Binding SelectedRun.WorkflowName}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           TextWrapping="WrapWholeWords" />
                <StackPanel Orientation="Horizontal"
                            Spacing="8">
                  <Border Padding="8,3"
                          CornerRadius="6"
                          Background="{Binding SelectedRun.WorkflowTagBackgroundBrush}">
                    <TextBlock Text="{Binding SelectedRun.WorkflowTagText}"
                               Foreground="{Binding SelectedRun.WorkflowTagForegroundBrush}"
                               FontSize="11"
                               FontWeight="SemiBold" />
                  </Border>
                  <Border Padding="8,3"
                          CornerRadius="6"
                          Background="{Binding SelectedRun.EventTagBackgroundBrush}">
                    <TextBlock Text="{Binding SelectedRun.EventTagText}"
                               Foreground="{Binding SelectedRun.EventTagForegroundBrush}"
                               FontSize="11"
                               FontWeight="SemiBold" />
                  </Border>
                </StackPanel>
                <TextBlock Text="{Binding SelectedRun.DisplayTitle}"
                           TextWrapping="WrapWholeWords" />
                <TextBlock Text="{Binding SelectedRun.WorkflowMetaSummary}"
                           Opacity="0.72" />
              </StackPanel>

              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Started:"
                           FontWeight="SemiBold" />
                <TextBlock Grid.Column="1"
                           Text="{Binding SelectedRun.CreatedAtDisplay}" />
                <TextBlock Grid.Column="2"
                           Text="Duration:"
                           Margin="16,0,0,0"
                           FontWeight="SemiBold" />
                <TextBlock Grid.Column="3"
                           Text="{Binding SelectedRun.DurationSummary}" />
              </Grid>

              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Displayed SHA:"
                           FontWeight="SemiBold" />
                <HyperlinkButton Grid.Column="1"
                                 Content="{Binding SelectedRun.UiShaDisplay}"
                                 Click="OpenLink_Click"
                                 Tag="{Binding SelectedRun.DisplayedCommitUrl}" />
                <TextBlock Grid.Column="2"
                           Text="Actual SHA:"
                           Margin="16,0,0,0"
                           FontWeight="SemiBold" />
                <HyperlinkButton Grid.Column="3"
                                 Content="{Binding SelectedRun.ActualShaDisplay}"
                                 Click="OpenLink_Click"
                                 Tag="{Binding SelectedRun.ActualCommitUrl}"
                                 IsEnabled="{Binding SelectedRun.HasActualCommitUrl}" />
              </Grid>

              <Expander x:Name="TriggerDetailsExpander"
                        Header="Trigger Details"
                        IsExpanded="False">
                <Grid ColumnSpacing="18"
                      HorizontalAlignment="Stretch"
                      Margin="0,8,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <StackPanel Spacing="6">
                    <TextBlock Text="Displayed By GitHub UI"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SelectedRun.UiSummary}" />
                    <TextBlock Text="{Binding SelectedRun.StatusSummary}" />
                    <TextBlock Text="{Binding SelectedRun.TriggerExplanation}"
                               TextWrapping="WrapWholeWords"
                               Opacity="0.78" />
                  </StackPanel>

                  <StackPanel Grid.Column="1"
                              Spacing="6">
                    <TextBlock Text="Resolved Trigger"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SelectedRun.ActualSummary}" />
                    <TextBlock Text="{Binding SelectedRun.PullRequestSummary}"
                               TextWrapping="WrapWholeWords" />
                    <TextBlock Text="{Binding SelectedRun.UpstreamRunSummary}"
                               TextWrapping="WrapWholeWords" />
                    <TextBlock Text="{Binding SelectedRun.ResolutionError}"
                               Foreground="IndianRed"
                               TextWrapping="WrapWholeWords" />
                  </StackPanel>
                </Grid>
              </Expander>

              <Expander x:Name="PullRequestDescriptionExpander"
                        Header="{Binding SelectedRun.RunDescriptionHeader}"
                        IsExpanded="False">
                <Border Padding="12"
                        Margin="0,8,0,0"
                        CornerRadius="14"
                        HorizontalAlignment="Stretch"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                  <TextBlock Text="{Binding SelectedRun.RunDescription}"
                             TextWrapping="WrapWholeWords" />
                </Border>
              </Expander>

              <Expander Header="Links"
                        IsExpanded="False">
                <Grid Margin="0,8,0,0"
                       ColumnSpacing="8"
                       HorizontalAlignment="Stretch"
                       RowSpacing="8">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <Button Grid.Row="0"
                          Grid.Column="0"
                          Content="Run"
                          Click="OpenLink_Click"
                          Tag="{Binding SelectedRun.RunUrl}" />
                  <Button Grid.Row="0"
                          Grid.Column="1"
                          Content="Displayed Commit"
                          Click="OpenLink_Click"
                          Tag="{Binding SelectedRun.DisplayedCommitUrl}" />
                  <Button Grid.Row="0"
                          Grid.Column="2"
                          Content="Actual Commit"
                          Click="OpenLink_Click"
                          Tag="{Binding SelectedRun.ActualCommitUrl}"
                          IsEnabled="{Binding SelectedRun.HasActualCommitUrl}" />
                  <Button Grid.Row="1"
                          Grid.Column="0"
                          Content="Pull Request"
                          Click="OpenLink_Click"
                          Tag="{Binding SelectedRun.PullRequestUrl}"
                          IsEnabled="{Binding SelectedRun.HasPullRequestUrl}" />
                  <Button Grid.Row="1"
                          Grid.Column="1"
                          Content="Upstream Run"
                          Click="OpenLink_Click"
                          Tag="{Binding SelectedRun.UpstreamRunUrl}"
                          IsEnabled="{Binding SelectedRun.HasUpstreamRunUrl}" />
                  <Button Grid.Row="1"
                          Grid.Column="2"
                          Content="Set Branch Job"
                          Click="OpenLink_Click"
                          Tag="{Binding SelectedRun.SetBranchJobUrl}"
                          IsEnabled="{Binding SelectedRun.HasSetBranchJobUrl}" />
                  <Button Grid.Row="2"
                          Grid.Column="0"
                          Content="Detection Job"
                          Click="OpenLink_Click"
                          Tag="{Binding SelectedRun.DetectJobUrl}"
                          IsEnabled="{Binding SelectedRun.HasDetectJobUrl}" />
                </Grid>
              </Expander>
            </StackPanel>
          </ScrollViewer>

          <ScrollViewer x:Name="ProcessDetailsScroll" Grid.Row="1" Visibility="Collapsed"
                        VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16">
              <StackPanel Spacing="12" Visibility="{Binding ShowProcessOverview, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{Binding ProcessOverviewSummary}" FontSize="16" TextWrapping="Wrap" />
                <TextBlock Text="Largest processes" FontWeight="SemiBold" FontSize="15" />
                <ItemsControl ItemsSource="{Binding LargestProcesses}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:ProcessKillEntry">
                      <Button Click="SelectProcess_Click" Tag="{Binding}" Style="{StaticResource QuietButtonStyle}"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="8">
                        <Grid ColumnSpacing="12">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding DisplayName}" FontSize="14" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding DisplayName}" />
                          <TextBlock Grid.Column="1" Text="{Binding Usage}" FontSize="14" />
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <StackPanel Spacing="14" Visibility="{Binding HasSelectedActivity, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{Binding SelectedActivity.Title}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding SelectedActivity.Description}" FontSize="14" TextWrapping="Wrap" />
                <TextBlock Text="Memory" FontSize="14" FontWeight="SemiBold" />
                <TextBlock Text="{Binding SelectedActivity.MemoryLabel}" FontSize="16" />
                <TextBlock Text="{Binding SelectedActivity.Reference}" FontSize="13" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
              </StackPanel>
            <StackPanel Spacing="12" Visibility="{Binding HasSelectedProcess, Converter={StaticResource BoolToVisibilityConverter}}">
              <TextBlock Text="{Binding SelectedProcess.DisplayName}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
              <Border Style="{StaticResource ContextCardStyle}">
                <StackPanel Spacing="6">
                  <TextBlock Text="Process memory" Style="{StaticResource ContextCardHeaderStyle}" />
                  <TextBlock Text="{Binding SelectedProcess.Usage}" FontSize="20" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding SelectedProcess.Note}" TextWrapping="Wrap" Opacity="0.72" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource ContextCardStyle}">
                <StackPanel Spacing="6">
                  <TextBlock Text="Start path" Style="{StaticResource ContextCardHeaderStyle}" />
                  <TextBlock Text="{Binding SelectedProcess.StartPath}" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontFamily="Consolas" FontSize="12" />
                </StackPanel>
              </Border>
              <Expander Header="Full command line">
                <TextBlock Text="{Binding SelectedProcess.CommandLine}" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontFamily="Consolas" FontSize="12" />
              </Expander>
              <Button Content="Inspect in System Informer" Click="InspectProcess_Click" Tag="{Binding SelectedProcess.ProcessId}" />
              <Button Content="Copy process details" Click="CopyProcessInfo_Click" Tag="{Binding SelectedProcess}" />
            </StackPanel>
            </StackPanel>
          </ScrollViewer>

          <ScrollViewer x:Name="StorageOverviewScroll" Grid.Row="1" Visibility="Collapsed"
                        VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12">
              <Border Style="{StaticResource ContextCardStyle}">
                <StackPanel Spacing="6">
                  <TextBlock Text="Disk analysis" Style="{StaticResource ContextCardHeaderStyle}" />
                  <TextBlock Text="{Binding DiskUsageHeadline}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding DiskUsageAnalysis}" TextWrapping="Wrap" Opacity="0.8" />
                  <TextBlock Text="{Binding DiskUsageStatusText}" TextWrapping="Wrap" Opacity="0.7" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource ContextCardStyle}">
                <StackPanel Spacing="6">
                  <TextBlock Text="Largest files" Style="{StaticResource ContextCardHeaderStyle}" />
                  <TextBlock Text="{Binding BiggestFilesScanRoot}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                  <TextBlock Text="{Binding BiggestFilesStatusText}" TextWrapping="Wrap" Opacity="0.8" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <!-- Live machine context belongs only to Resources. -->
          <ScrollViewer x:Name="SystemOverviewScroll"
                        Grid.Row="1"
                        Visibility="Collapsed"
                        HorizontalAlignment="Stretch"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="10"
                        HorizontalAlignment="Stretch">

              <Border Style="{StaticResource ContextCardStyle}">
                <StackPanel>
                  <TextBlock Text="This machine"
                             Style="{StaticResource ContextCardHeaderStyle}" />
                  <TextBlock Text="{Binding MachineSpecText}"
                             TextWrapping="WrapWholeWords"
                             FontFamily="Consolas"
                             FontSize="12"
                             Opacity="0.82" />
                </StackPanel>
              </Border>

              <Border Style="{StaticResource ContextCardStyle}">
                <StackPanel>
                  <TextBlock Text="Current bottleneck"
                             Style="{StaticResource ContextCardHeaderStyle}" />
                  <TextBlock Text="{Binding ResourceVerdictText}"
                             TextWrapping="WrapWholeWords"
                             Opacity="0.88" />
                </StackPanel>
              </Border>

              <Border Style="{StaticResource ContextCardStyle}">
                <StackPanel>
                  <TextBlock Text="Memory budget"
                             Style="{StaticResource ContextCardHeaderStyle}" />
                  <StackPanel Spacing="6">
                    <TextBlock Text="Committed"
                               FontSize="12"
                               Opacity="0.7" />
                    <ProgressBar Value="{Binding CommitPercentValue}"
                                 Maximum="100"
                                 Height="6" />
                    <TextBlock Text="{Binding CommitValueText}"
                               FontFamily="Consolas"
                               FontSize="11"
                               Opacity="0.78"
                               TextWrapping="WrapWholeWords" />

                    <TextBlock Text="Physical RAM"
                               FontSize="12"
                               Opacity="0.7"
                               Margin="0,6,0,0" />
                    <ProgressBar Value="{Binding MemoryPercentValue}"
                                 Maximum="100"
                                 Height="6" />
                    <TextBlock Text="{Binding MemoryValueText}"
                               FontFamily="Consolas"
                               FontSize="11"
                               Opacity="0.78"
                               TextWrapping="WrapWholeWords" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource ContextCardStyle}">
                <StackPanel>
                  <TextBlock Text="Heaviest sessions"
                             Style="{StaticResource ContextCardHeaderStyle}" />
                  <ItemsControl ItemsSource="{Binding TopAgentSessions}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Margin="0,0,0,10"
                                    Spacing="2">
                          <TextBlock Text="{Binding HeadlineText}"
                                     FontSize="12"
                                     FontWeight="SemiBold"
                                     TextWrapping="WrapWholeWords" />
                          <TextBlock Text="{Binding SubtitleText}"
                                     FontSize="11"
                                     Opacity="0.75"
                                     TextWrapping="WrapWholeWords" />
                          <ProgressBar Value="{Binding SharePercent}"
                                       Maximum="100"
                                       Height="5" />
                          <TextBlock Text="{Binding DetailText}"
                                     FontFamily="Consolas"
                                     FontSize="10"
                                     Opacity="0.65"
                                     TextWrapping="WrapWholeWords" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Page>
