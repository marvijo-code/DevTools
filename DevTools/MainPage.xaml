<Page x:Class="DevTools.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:models="using:DevTools.Models"
      xmlns:infra="using:DevTools.Infrastructure"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Page.Resources>
    <infra:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <Style TargetType="ListView">
      <Setter Property="HorizontalAlignment"
              Value="Stretch" />
      <Setter Property="HorizontalContentAlignment"
              Value="Stretch" />
    </Style>
    <Style TargetType="ListViewItem">
      <Setter Property="HorizontalContentAlignment"
              Value="Stretch" />
    </Style>
    <!-- Expanders read as bare buttons with the default template. Giving them a card surface, a border
         and real padding makes them look like the panels they actually are. -->
    <Style TargetType="Expander">
      <Setter Property="HorizontalAlignment"
              Value="Stretch" />
      <Setter Property="HorizontalContentAlignment"
              Value="Stretch" />
      <Setter Property="Background"
              Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
      <Setter Property="BorderBrush"
              Value="{ThemeResource CardStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness"
              Value="1" />
      <Setter Property="CornerRadius"
              Value="10" />
      <Setter Property="Padding"
              Value="14,12" />
      <Setter Property="MinHeight"
              Value="48" />
    </Style>

    <!-- Shared card surface for the right-hand context panel sections. -->
    <Style x:Key="ContextCardStyle"
           TargetType="Border">
      <Setter Property="Padding"
              Value="14" />
      <Setter Property="CornerRadius"
              Value="12" />
      <Setter Property="HorizontalAlignment"
              Value="Stretch" />
      <Setter Property="Background"
              Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
      <Setter Property="BorderBrush"
              Value="{ThemeResource CardStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness"
              Value="1" />
    </Style>

    <Style x:Key="ContextCardHeaderStyle"
           TargetType="TextBlock">
      <Setter Property="FontWeight"
              Value="SemiBold" />
      <Setter Property="FontSize"
              Value="13" />
      <Setter Property="Opacity"
              Value="0.9" />
      <Setter Property="Margin"
              Value="0,0,0,8" />
    </Style>

    <!-- Chart palette: one hue per metric so the five sparklines stay distinguishable at a glance. -->
    <SolidColorBrush x:Key="ChartCpuLineBrush"
                     Color="#4FC3F7" />
    <SolidColorBrush x:Key="ChartCpuAreaBrush"
                     Color="#4FC3F7"
                     Opacity="0.20" />
    <SolidColorBrush x:Key="ChartCommitLineBrush"
                     Color="#EF5350" />
    <SolidColorBrush x:Key="ChartCommitAreaBrush"
                     Color="#EF5350"
                     Opacity="0.20" />
    <SolidColorBrush x:Key="ChartMemoryLineBrush"
                     Color="#FFB74D" />
    <SolidColorBrush x:Key="ChartMemoryAreaBrush"
                     Color="#FFB74D"
                     Opacity="0.20" />
    <SolidColorBrush x:Key="ChartDiskLineBrush"
                     Color="#66BB6A" />
    <SolidColorBrush x:Key="ChartDiskAreaBrush"
                     Color="#66BB6A"
                     Opacity="0.20" />
    <SolidColorBrush x:Key="ChartFaultLineBrush"
                     Color="#BA68C8" />
    <SolidColorBrush x:Key="ChartFaultAreaBrush"
                     Color="#BA68C8"
                     Opacity="0.20" />
    <SolidColorBrush x:Key="ChartSpaceLineBrush"
                     Color="#4DD0E1" />
    <SolidColorBrush x:Key="ChartSpaceAreaBrush"
                     Color="#4DD0E1"
                     Opacity="0.20" />
  </Page.Resources>
  <Grid x:Name="RootLayoutGrid"
        Margin="12"
        RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0"
          ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="104" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="1"
              Padding="16"
              CornerRadius="18"
              HorizontalAlignment="Stretch"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1">
        <Grid ColumnSpacing="18"
              RowSpacing="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock Text="DevTools"
                     FontSize="26"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center" />

          <TextBlock Grid.Column="1"
                     Grid.RowSpan="2"
                     Text="Compact repo dashboard for workflow runs, PR context, and disk usage hotspots."
                     Opacity="0.72"
                     MaxWidth="680"
                     VerticalAlignment="Center"
                     TextWrapping="WrapWholeWords" />

          <StackPanel Grid.Row="1"
                      Orientation="Horizontal"
                      Spacing="8">
            <Button x:Name="ResourcesTabButton"
                    Content="Resources"
                    Click="ResourcesTabButton_Click"
                    MinWidth="120" />
            <Button x:Name="KillProcessesTabButton"
                    Content="Kill Processes"
                    Click="KillProcessesTabButton_Click"
                    MinWidth="140" />
            <Button x:Name="WorkflowTabButton"
                    Content="GitHub Workflow Explorer"
                    Click="WorkflowTabButton_Click"
                    MinWidth="160" />
            <Button x:Name="DiskTabButton"
                    Content="Disk Usage Analysis"
                    Click="DiskTabButton_Click"
                    MinWidth="160" />
          </StackPanel>
        </Grid>
      </Border>

      <Button Grid.Column="2"
              Content="Refresh Now"
              Click="RefreshNow_Click"
              MinWidth="132"
              VerticalAlignment="Stretch" />
    </Grid>

    <Grid Grid.Row="1"
          ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="104" />
        <ColumnDefinition Width="1.55*" />
        <ColumnDefinition Width="1.1*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0"
              Padding="8"
              CornerRadius="18"
              HorizontalAlignment="Stretch"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1">
        <Grid RowSpacing="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Border Height="56"
                  CornerRadius="14"
                  Background="{ThemeResource AccentFillColorDefaultBrush}">
            <TextBlock Text="DT"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
          </Border>

          <StackPanel Grid.Row="1"
                      Spacing="8">
            <Button Content="Resources"
                    Click="NavigateToResources_Click" />
            <Button Content="Processes"
                    Click="NavigateToKillProcesses_Click" />
            <Button Content="Runs"
                    Click="NavigateToRuns_Click" />
            <Button Content="Details"
                    Click="NavigateToDetails_Click" />
            <Button Content="Storage"
                    Click="NavigateToDisk_Click" />
            <Button Content="Auth"
                    Click="NavigateToRepos_Click" />
            <Button Content="Logs"
                    Click="OpenLogs_Click" />
          </StackPanel>

          <StackPanel Grid.Row="2"
                      Spacing="4">
            <TextBlock Text="{Binding RepositorySummaryText}"
                       HorizontalAlignment="Center"
                       FontWeight="SemiBold"
                       FontSize="12" />
            <TextBlock Text="{Binding VisibleRunsText}"
                       HorizontalAlignment="Center"
                       Opacity="0.72"
                       FontSize="12" />
          </StackPanel>
        </Grid>
      </Border>

      <Border x:Name="MainContentBorder"
              Grid.Column="1"
              Padding="14"
              CornerRadius="18"
              HorizontalAlignment="Stretch"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1">
        <Grid>
          <Grid x:Name="KillProcessesContentPane"
                RowSpacing="10"
                Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <StackPanel>
                <TextBlock Text="Kill Processes"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="{Binding KillProcessesHeadline}"
                           TextWrapping="WrapWholeWords"
                           Opacity="0.72" />
                <StackPanel Orientation="Horizontal"
                            Spacing="8">
                  <ProgressRing Width="16"
                                Height="16"
                                IsActive="{Binding IsKillProcessesRefreshing}"
                                VerticalAlignment="Center" />
                  <TextBlock Text="{Binding KillProcessesStatusText}"
                             VerticalAlignment="Center"
                             FontFamily="Consolas"
                             FontSize="12"
                             Opacity="0.74" />
                </StackPanel>
              </StackPanel>

              <Button Grid.Column="1"
                      Content="Refresh Processes"
                      Click="RefreshKillProcesses_Click" />
            </Grid>

            <TextBox x:Name="ProcessFilterBox"
                     Grid.Row="1"
                     Header="Search"
                     PlaceholderText="name, PID, command line, memory..."
                     Text="{Binding ProcessFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <ScrollViewer x:Name="KillProcessesScroll"
                          Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="10">
                <Grid ColumnSpacing="10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <TextBlock Text="{Binding KillProcessesSummary}"
                             TextWrapping="WrapWholeWords"
                             Opacity="0.82" />
                  <Border Grid.Column="1"
                          Padding="10,5"
                          CornerRadius="8"
                          Background="{ThemeResource AccentFillColorSecondaryBrush}">
                    <TextBlock Text="{Binding VisibleProcessesText}"
                               FontWeight="SemiBold" />
                  </Border>
                </Grid>

                <ItemsControl ItemsSource="{Binding KillProcessSections}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:ProcessKillSection">
                      <StackPanel Spacing="0"
                                  Margin="0,0,0,8">
                        <Grid ColumnSpacing="8"
                              Margin="0,0,0,4">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>

                          <Button Grid.Column="0"
                                  Content="{Binding ExpandGlyph}"
                                  Click="ToggleProcessSection_Click"
                                  Tag="{Binding}"
                                  MinWidth="32"
                                  Padding="8,2"
                                  FontFamily="Consolas"
                                  FontWeight="SemiBold"
                                  VerticalAlignment="Top"
                                  ToolTipService.ToolTip="Expand or collapse this group" />
                          <StackPanel Grid.Column="1"
                                      VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding StartPath}"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       Opacity="0.66"
                                       TextWrapping="WrapWholeWords" />
                            <TextBlock Text="{Binding Summary}"
                                       TextWrapping="WrapWholeWords"
                                       Opacity="0.76"
                                       FontSize="12" />
                          </StackPanel>
                          <Button Grid.Column="2"
                                  Content="Kill All"
                                  Click="KillProcessSection_Click"
                                  Tag="{Binding}"
                                  VerticalAlignment="Top" />
                        </Grid>

                        <Border Padding="10"
                                Margin="28,0,0,0"
                                CornerRadius="14"
                                HorizontalAlignment="Stretch"
                                Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                          <StackPanel Spacing="8">
                            <Grid ColumnSpacing="10"
                                  Margin="0,0,0,4">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="1.9*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>
                              <TextBlock Text="Process"
                                         FontSize="11"
                                         FontWeight="SemiBold"
                                         Opacity="0.62" />
                              <TextBlock Grid.Column="1"
                                         Text="Start Path"
                                         FontSize="11"
                                         FontWeight="SemiBold"
                                         Opacity="0.62"
                                         Margin="10,0,0,0" />
                              <TextBlock Grid.Column="2"
                                         Text="Memory"
                                         FontSize="11"
                                         FontWeight="SemiBold"
                                         Opacity="0.62"
                                         Margin="10,0,0,0" />
                              <TextBlock Grid.Column="3"
                                         Text="Action"
                                         FontSize="11"
                                         FontWeight="SemiBold"
                                         Opacity="0.62"
                                         Margin="10,0,0,0" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Entries}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:ProcessKillEntry">
                                  <Grid ColumnSpacing="10"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="1.1*" />
                                      <ColumnDefinition Width="1.9*" />
                                      <ColumnDefinition Width="Auto" />
                                      <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                      <TextBlock Text="{Binding DisplayName}"
                                                 FontSize="13"
                                                 FontWeight="SemiBold"
                                                 TextWrapping="WrapWholeWords" />
                                      <TextBlock Text="{Binding Note}"
                                                 FontFamily="Consolas"
                                                 FontSize="11"
                                                 Opacity="0.66"
                                                 TextWrapping="WrapWholeWords" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding StartPath}"
                                               FontFamily="Consolas"
                                               FontSize="11"
                                               TextWrapping="WrapWholeWords"
                                               VerticalAlignment="Top"
                                               Margin="10,0,0,0" />

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Usage}"
                                               VerticalAlignment="Top"
                                               FontWeight="SemiBold"
                                               Margin="10,0,0,0" />
                                    <StackPanel Grid.Column="3"
                                                Orientation="Horizontal"
                                                Spacing="8"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Top">
                                      <Button Content="Copy"
                                              Click="CopyProcessInfo_Click"
                                              Tag="{Binding}" />
                                      <Button Content="Kill"
                                              Click="KillProcess_Click"
                                              Tag="{Binding ProcessId}"
                                              IsEnabled="{Binding CanKill}" />
                                    </StackPanel>
                                  </Grid>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </Border>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </Grid>

          <Grid x:Name="WorkflowContentPane"
                RowSpacing="10">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <StackPanel>
                <TextBlock Text="GitHub Workflow Explorer"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="Filter by repo, workflow, branch, author, PR text, SHA, and status."
                           Opacity="0.7" />
              </StackPanel>

              <ComboBox Grid.Column="1"
                        Header="Status"
                        ItemsSource="{Binding StatusFilterOptions}"
                        SelectedItem="{Binding StatusFilter, Mode=TwoWay}" />

              <Border Grid.Column="2"
                      Padding="10,5"
                      CornerRadius="8"
                      Background="{ThemeResource AccentFillColorSecondaryBrush}">
                <TextBlock Text="{Binding VisibleRunsText}"
                           FontWeight="SemiBold" />
              </Border>
            </Grid>

            <TextBox x:Name="RunFilterBox"
                     Grid.Row="1"
                     Header="Search"
                     PlaceholderText="&lt;author&gt;, PR #123, &lt;branch&gt;, &lt;repo&gt;, PR description, &lt;sha&gt;..."
                     Text="{Binding RunFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <Expander x:Name="RepositoryExpander"
                      Grid.Row="2"
                      Header="Auth, Refresh, and Repository Setup"
                      HorizontalAlignment="Stretch"
                      IsExpanded="False">
              <Border Padding="12"
                      CornerRadius="14"
                      Background="{ThemeResource LayerFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1">
                <StackPanel Spacing="8">
                  <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding StatusMessage}"
                               TextWrapping="WrapWholeWords"
                               Opacity="0.86" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding AuthMessage}"
                               TextWrapping="WrapWholeWords"
                               Opacity="0.72" />
                  </Grid>

                  <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="130" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding LastRefreshText}"
                               Opacity="0.68"
                               VerticalAlignment="Center" />

                    <ToggleSwitch Grid.Column="1"
                                  Header="Auto Refresh"
                                  IsOn="{Binding AutoRefreshEnabled, Mode=TwoWay}"
                                  OnContent="On"
                                  OffContent="Off"
                                  VerticalAlignment="Center" />

                    <ComboBox Grid.Column="2"
                              Header="Refresh Every"
                              ItemsSource="{Binding RefreshIntervalOptions}"
                              SelectedItem="{Binding RefreshIntervalSeconds, Mode=TwoWay}" />
                  </Grid>

                  <TextBlock Text="{Binding RefreshIntervalSummary}"
                             Opacity="0.68" />

                  <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="Sign In (gh)"
                            Click="GhLogin_Click" />
                    <Button Grid.Column="1"
                            Content="Use gh Token"
                            Click="UseGhToken_Click" />
                    <Button Grid.Column="2"
                            Content="Reload Auth"
                            Click="ReloadAuth_Click" />
                    <Button Grid.Column="3"
                            Content="Open Logs"
                            Click="OpenLogs_Click" />
                    <Button Grid.Column="4"
                            Content="Add Repo"
                            Click="AddRepository_Click" />
                  </Grid>

                  <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="PatInputBox"
                             Header="Personal Access Token (PAT)"
                             PlaceholderText="github_pat_..."
                             Grid.Column="0" />
                    <Button Grid.Column="1"
                            Content="Use PAT"
                            Click="UsePat_Click"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,1" />
                    <Button Grid.Column="2"
                            Content="Clear PAT"
                            Click="ClearPat_Click"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,1" />
                  </Grid>

                  <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             x:Name="OwnerInputBox"
                             Header="Owner"
                             Text="{Binding OwnerInput, Mode=TwoWay}" />
                    <TextBox Grid.Column="1"
                             Header="Repository"
                             PlaceholderText="owner/repo also works here"
                             Text="{Binding RepoInput, Mode=TwoWay}" />
                  </Grid>

                  <ListView ItemsSource="{Binding Repositories}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            MaxHeight="88"
                            SelectionMode="None">
                    <ListView.ItemTemplate>
                      <DataTemplate x:DataType="models:RepositoryDefinition">
                        <Grid ColumnSpacing="8"
                              HorizontalAlignment="Stretch"
                              Padding="0,2">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding FullName}"
                                     VerticalAlignment="Center" />
                          <Button Grid.Column="1"
                                  Content="Remove"
                                  Click="RemoveRepository_Click"
                                  Tag="{Binding}" />
                        </Grid>
                      </DataTemplate>
                    </ListView.ItemTemplate>
                  </ListView>
                </StackPanel>
              </Border>
            </Expander>

            <ListView x:Name="RunsList"
                      Grid.Row="3"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      ItemsSource="{Binding Runs}"
                      SelectedItem="{Binding SelectedRun, Mode=TwoWay}"
                      SelectionChanged="RunsList_SelectionChanged">
              <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:WorkflowRunItem">
                  <Border Padding="12"
                          Margin="0,0,0,8"
                          CornerRadius="14"
                          HorizontalAlignment="Stretch"
                          Background="{Binding StatusBackgroundBrush}"
                          BorderBrush="{Binding StatusBorderBrush}"
                          BorderThickness="1">
                    <StackPanel Spacing="7">
                      <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding Repository.FullName}"
                                   Opacity="0.72"
                                   VerticalAlignment="Center" />

                        <Border Grid.Column="1"
                                Padding="8,4"
                                CornerRadius="6"
                                Background="{Binding StatusForegroundBrush}">
                          <TextBlock Text="{Binding StatusBadgeText}"
                                     Foreground="White"
                                     FontSize="12"
                                     FontWeight="SemiBold" />
                        </Border>
                      </Grid>

                      <TextBlock Text="{Binding WorkflowName}"
                                 FontSize="17"
                                 FontWeight="SemiBold"
                                 MaxLines="1"
                                 TextTrimming="CharacterEllipsis" />

                      <StackPanel Orientation="Horizontal"
                                  Spacing="8">
                        <Border Padding="8,3"
                                CornerRadius="6"
                                Background="{Binding WorkflowTagBackgroundBrush}">
                          <TextBlock Text="{Binding WorkflowTagText}"
                                     Foreground="{Binding WorkflowTagForegroundBrush}"
                                     FontSize="11"
                                     FontWeight="SemiBold" />
                        </Border>
                        <Border Padding="8,3"
                                CornerRadius="6"
                                Background="{Binding EventTagBackgroundBrush}">
                          <TextBlock Text="{Binding EventTagText}"
                                     Foreground="{Binding EventTagForegroundBrush}"
                                     FontSize="11"
                                     FontWeight="SemiBold" />
                        </Border>
                      </StackPanel>

                      <TextBlock Text="{Binding DisplayTitle}"
                                 MaxLines="2"
                                 TextWrapping="WrapWholeWords"
                                 TextTrimming="CharacterEllipsis" />

                      <TextBlock Text="{Binding WorkflowMetaSummary}"
                                 Opacity="0.72"
                                 FontSize="12" />

                      <TextBlock Text="{Binding TimelineSummary}"
                                 Opacity="0.72"
                                 FontSize="12" />

                      <TextBlock Text="{Binding RunDescriptionPreview}"
                                 FontSize="12"
                                 Opacity="0.78"
                                 MaxLines="2"
                                 TextWrapping="WrapWholeWords"
                                 TextTrimming="CharacterEllipsis" />

                      <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                          <TextBlock Text="{Binding UiSummary}" />
                          <TextBlock Text="{Binding ActualSummary}"
                                     Opacity="0.78"
                                     FontSize="12" />
                          <StackPanel Orientation="Horizontal"
                                      Spacing="8">
                            <HyperlinkButton Content="{Binding UiShaDisplay}"
                                             Click="OpenLink_Click"
                                             Tag="{Binding DisplayedCommitUrl}" />
                            <HyperlinkButton Content="{Binding ActualShaDisplay}"
                                             Click="OpenLink_Click"
                                             Tag="{Binding ActualCommitUrl}"
                                             IsEnabled="{Binding HasActualCommitUrl}" />
                          </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="Open Run"
                                Click="OpenLink_Click"
                                Tag="{Binding RunUrl}"
                                VerticalAlignment="Center" />
                      </Grid>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
          </Grid>

          <Grid x:Name="DiskContentPane"
                RowSpacing="10"
                Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <StackPanel>
                <TextBlock Text="Disk Usage Analysis"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="{Binding DiskUsageHeadline}"
                           TextWrapping="WrapWholeWords"
                           Opacity="0.72" />
                <StackPanel Orientation="Horizontal"
                            Spacing="8">
                  <ProgressRing Width="16"
                                Height="16"
                                IsActive="{Binding IsDiskUsageRefreshing}"
                                VerticalAlignment="Center" />
                  <TextBlock Text="{Binding DiskUsageActivityText}"
                             VerticalAlignment="Center"
                             FontFamily="Consolas"
                             FontSize="12"
                             Opacity="0.74" />
                </StackPanel>
                <TextBlock Text="{Binding DiskUsageStatusText}"
                           TextWrapping="WrapWholeWords"
                           Opacity="0.62"
                           FontSize="12" />
              </StackPanel>

              <Button Grid.Column="1"
                      Content="Refresh Space Analyzer"
                      Click="RefreshDiskUsage_Click" />
            </Grid>

            <ScrollViewer x:Name="DiskScroll"
                          Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="10">
                <Border Padding="12"
                        CornerRadius="14"
                        HorizontalAlignment="Stretch"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Biggest Files"
                               FontSize="16"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding BiggestFilesHeadline}"
                               TextWrapping="WrapWholeWords"
                               Opacity="0.72"
                               FontSize="12" />

                    <Border Padding="10,8"
                            CornerRadius="10"
                            Background="{ThemeResource AccentFillColorSecondaryBrush}"
                            Visibility="{Binding ShowElevationHint, Converter={StaticResource BoolToVisibilityConverter}}">
                      <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Not running as administrator — scans use the slower fallback engine. Restart as admin for the fast NTFS scan."
                                   TextWrapping="WrapWholeWords"
                                   VerticalAlignment="Center"
                                   FontSize="12" />
                        <Button Grid.Column="1"
                                Content="Restart as Admin"
                                Click="RestartAsAdmin_Click"
                                VerticalAlignment="Center" />
                      </Grid>
                    </Border>

                    <Grid ColumnSpacing="8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBox Grid.Column="0"
                               Header="Scan root or folder"
                               Text="{Binding BiggestFilesScanRoot, Mode=TwoWay}" />
                      <Button Grid.Column="1"
                              Content="C:\"
                              Click="SetBiggestFilesRootSystem_Click"
                              VerticalAlignment="Bottom" />
                      <Button Grid.Column="2"
                              Content="C:\dev"
                              Click="SetBiggestFilesRootDev_Click"
                              VerticalAlignment="Bottom" />
                    </Grid>

                    <Grid ColumnSpacing="8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <ComboBox Grid.Column="0"
                                Header="Top"
                                MinWidth="88"
                                ItemsSource="{Binding BiggestFilesTopCountOptions}"
                                SelectedItem="{Binding BiggestFilesTopCount, Mode=TwoWay}" />
                      <TextBox Grid.Column="1"
                               Header="Search"
                               PlaceholderText="name, folder, path..."
                               Text="{Binding BiggestFilesFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                      <Button Grid.Column="2"
                              Content="Scan"
                              Click="StartBiggestFilesScan_Click"
                              VerticalAlignment="Bottom" />
                      <Button Grid.Column="3"
                              Content="Cancel"
                              Click="CancelBiggestFilesScan_Click"
                              IsEnabled="{Binding IsBiggestFilesScanning}"
                              VerticalAlignment="Bottom" />
                    </Grid>

                    <Grid ColumnSpacing="10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Orientation="Horizontal"
                                  Spacing="8">
                        <ProgressRing Width="16"
                                      Height="16"
                                      IsActive="{Binding IsBiggestFilesScanning}"
                                      VerticalAlignment="Center" />
                        <TextBlock Text="{Binding BiggestFilesStatusText}"
                                   VerticalAlignment="Center"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   Opacity="0.74"
                                   TextWrapping="WrapWholeWords" />
                      </StackPanel>
                      <Border Grid.Column="1"
                              Padding="10,5"
                              CornerRadius="8"
                              VerticalAlignment="Center"
                              Background="{ThemeResource AccentFillColorSecondaryBrush}">
                        <TextBlock Text="{Binding VisibleBiggestFilesText}"
                                   FontWeight="SemiBold" />
                      </Border>
                    </Grid>

                    <ListView ItemsSource="{Binding BiggestFiles}"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              MaxHeight="460"
                              SelectionMode="None">
                      <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:BiggestFileEntry">
                          <Grid ColumnSpacing="10"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                              <HyperlinkButton Content="{Binding FileName}"
                                               Click="RevealBiggestFile_Click"
                                               Tag="{Binding Path}"
                                               HorizontalAlignment="Left"
                                               FontSize="13" />
                              <TextBlock Text="{Binding DirectoryPath}"
                                         FontFamily="Consolas"
                                         FontSize="11"
                                         Opacity="0.6"
                                         TextWrapping="WrapWholeWords" />
                              <TextBlock Text="{Binding Note}"
                                         FontSize="11"
                                         Opacity="0.66" />
                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding Usage}"
                                       VerticalAlignment="Top"
                                       FontWeight="SemiBold"
                                       Margin="10,6,0,0" />
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        VerticalAlignment="Top"
                                        Margin="10,2,0,0">
                              <Button Content="Copy"
                                      Click="CopyBiggestFilePath_Click"
                                      Tag="{Binding}" />
                              <Button Content="Delete"
                                      Click="DeleteBiggestFile_Click"
                                      Tag="{Binding}" />
                            </StackPanel>
                          </Grid>
                        </DataTemplate>
                      </ListView.ItemTemplate>
                    </ListView>
                  </StackPanel>
                </Border>

                <TextBlock Text="{Binding DiskUsageAnalysis}"
                           TextWrapping="WrapWholeWords"
                           Opacity="0.82" />

                <ItemsControl ItemsSource="{Binding DiskUsageSections}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:DiskUsageSection">
                      <Expander Header="{Binding Title}"
                                HorizontalAlignment="Stretch"
                                IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                        <Border Padding="10"
                                Margin="0,0,0,8"
                                CornerRadius="14"
                                HorizontalAlignment="Stretch"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                          <StackPanel Spacing="8">
                            <TextBlock Text="{Binding Summary}"
                                       TextWrapping="WrapWholeWords"
                                       Opacity="0.76"
                                       FontSize="12" />

                            <ItemsControl ItemsSource="{Binding Entries}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:DiskUsageEntry">
                                  <StackPanel Margin="0,0,0,6">
                                    <Grid ColumnSpacing="10"
                                          HorizontalAlignment="Stretch">
                                      <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                      </Grid.ColumnDefinitions>

                                      <Button Grid.Column="0"
                                              Content="{Binding ExpandGlyph}"
                                              Click="ToggleDiskEntry_Click"
                                              Tag="{Binding}"
                                              MinWidth="32"
                                              Padding="8,2"
                                              FontFamily="Consolas"
                                              FontWeight="SemiBold"
                                              VerticalAlignment="Top"
                                              Visibility="{Binding HasChildren, Converter={StaticResource BoolToVisibilityConverter}}"
                                              ToolTipService.ToolTip="Expand or collapse the largest children" />

                                      <StackPanel Grid.Column="1">
                                        <HyperlinkButton Content="{Binding DisplayName}"
                                                         Click="OpenPath_Click"
                                                         Tag="{Binding Path}"
                                                         HorizontalAlignment="Left"
                                                         FontSize="13" />
                                        <TextBlock Text="{Binding Note}"
                                                   FontFamily="Consolas"
                                                   FontSize="11"
                                                   Opacity="0.66"
                                                   TextWrapping="WrapWholeWords" />
                                      </StackPanel>

                                      <TextBlock Grid.Column="2"
                                                 Text="{Binding Usage}"
                                                 VerticalAlignment="Top"
                                                 FontWeight="SemiBold"
                                                 Margin="10,0,0,0" />
                                      <Button Grid.Column="3"
                                              Content="Clear Folder"
                                              Click="ClearFolder_Click"
                                              Tag="{Binding Path}"
                                              IsEnabled="{Binding CanClear}"
                                              Margin="10,0,0,0"
                                              VerticalAlignment="Top" />
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding Children}"
                                                  Margin="42,4,0,0"
                                                  Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                                      <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:DiskUsageEntry">
                                          <Grid ColumnSpacing="10"
                                                HorizontalAlignment="Stretch"
                                                Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                              <ColumnDefinition Width="*" />
                                              <ColumnDefinition Width="Auto" />
                                              <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>
                                              <HyperlinkButton Content="{Binding DisplayName}"
                                                               Click="OpenPath_Click"
                                                               Tag="{Binding Path}"
                                                               HorizontalAlignment="Left"
                                                               FontSize="12" />
                                              <TextBlock Text="{Binding Note}"
                                                         FontFamily="Consolas"
                                                         FontSize="10"
                                                         Opacity="0.6"
                                                         TextWrapping="WrapWholeWords" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Usage}"
                                                       VerticalAlignment="Top"
                                                       FontWeight="SemiBold"
                                                       FontSize="12"
                                                       Margin="10,0,0,0" />
                                            <Button Grid.Column="2"
                                                    Content="Clear Folder"
                                                    Click="ClearFolder_Click"
                                                    Tag="{Binding Path}"
                                                    IsEnabled="{Binding CanClear}"
                                                    Margin="10,0,0,0"
                                                    VerticalAlignment="Top" />
                                          </Grid>
                                        </DataTemplate>
                                      </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                  </StackPanel>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </Border>
                      </Expander>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </Grid>

          <Grid x:Name="ResourcesContentPane"
                RowSpacing="10"
                Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <StackPanel>
                <TextBlock Text="Resource Monitor"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="{Binding ResourceVerdictText}"
                           TextWrapping="WrapWholeWords"
                           Opacity="0.86" />
                <TextBlock Text="{Binding ResourceCountsText}"
                           FontFamily="Consolas"
                           FontSize="12"
                           Opacity="0.72" />
                <TextBlock Text="{Binding ResourceStatusText}"
                           FontFamily="Consolas"
                           FontSize="12"
                           Opacity="0.62" />
              </StackPanel>

              <StackPanel Grid.Column="1"
                          Spacing="6">
                <ToggleSwitch Header="Monitoring"
                              OnContent="Recording"
                              OffContent="Paused"
                              IsOn="{Binding ResourceMonitoringEnabled, Mode=TwoWay}" />
                <ComboBox Header="Sample every (s)"
                          MinWidth="130"
                          ItemsSource="{Binding ResourceIntervalOptions}"
                          SelectedItem="{Binding ResourceIntervalSeconds, Mode=TwoWay}" />
                <Button Content="Clear History"
                        HorizontalAlignment="Stretch"
                        Click="ClearResourceHistory_Click" />
              </StackPanel>
            </Grid>

            <TextBlock Grid.Row="1"
                       Text="{Binding ResourceWindowText}"
                       FontFamily="Consolas"
                       FontSize="12"
                       Opacity="0.62" />

            <ScrollViewer x:Name="ResourcesScroll"
                          Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="10">

                <!-- Metric history. Oldest sample on the left, newest on the right. -->
                <Border Padding="12"
                        CornerRadius="14"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                  <StackPanel Spacing="12">
                    <TextBlock Text="Usage over time"
                               FontWeight="SemiBold" />

                    <StackPanel Spacing="4">
                      <Grid>
                        <TextBlock Text="CPU"
                                   FontWeight="SemiBold"
                                   FontSize="13" />
                        <TextBlock Text="{Binding CpuValueText}"
                                   HorizontalAlignment="Right"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   Opacity="0.82" />
                      </Grid>
                      <infra:SparklineChart Height="52"
                                            Maximum="100"
                                            Values="{Binding CpuSeries}"
                                            LineBrush="{StaticResource ChartCpuLineBrush}"
                                            AreaBrush="{StaticResource ChartCpuAreaBrush}" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                      <Grid>
                        <TextBlock Text="Committed memory (% of commit limit)"
                                   FontWeight="SemiBold"
                                   FontSize="13" />
                        <TextBlock Text="{Binding CommitValueText}"
                                   HorizontalAlignment="Right"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   Opacity="0.82" />
                      </Grid>
                      <infra:SparklineChart Height="52"
                                            Maximum="100"
                                            Values="{Binding CommitSeries}"
                                            LineBrush="{StaticResource ChartCommitLineBrush}"
                                            AreaBrush="{StaticResource ChartCommitAreaBrush}" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                      <Grid>
                        <TextBlock Text="Physical RAM in use"
                                   FontWeight="SemiBold"
                                   FontSize="13" />
                        <TextBlock Text="{Binding MemoryValueText}"
                                   HorizontalAlignment="Right"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   Opacity="0.82" />
                      </Grid>
                      <infra:SparklineChart Height="52"
                                            Maximum="100"
                                            Values="{Binding MemorySeries}"
                                            LineBrush="{StaticResource ChartMemoryLineBrush}"
                                            AreaBrush="{StaticResource ChartMemoryAreaBrush}" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                      <Grid>
                        <TextBlock Text="Disk throughput (MB/s)"
                                   FontWeight="SemiBold"
                                   FontSize="13" />
                        <TextBlock Text="{Binding DiskValueText}"
                                   HorizontalAlignment="Right"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   Opacity="0.82" />
                      </Grid>
                      <infra:SparklineChart Height="52"
                                            Maximum="20"
                                            Values="{Binding DiskSeries}"
                                            LineBrush="{StaticResource ChartDiskLineBrush}"
                                            AreaBrush="{StaticResource ChartDiskAreaBrush}" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                      <Grid>
                        <TextBlock Text="Hard page faults per second (paging pressure)"
                                   FontWeight="SemiBold"
                                   FontSize="13" />
                        <TextBlock Text="{Binding HardFaultValueText}"
                                   HorizontalAlignment="Right"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   Opacity="0.82" />
                      </Grid>
                      <infra:SparklineChart Height="52"
                                            Maximum="200"
                                            Values="{Binding HardFaultSeries}"
                                            LineBrush="{StaticResource ChartFaultLineBrush}"
                                            AreaBrush="{StaticResource ChartFaultAreaBrush}" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                      <Grid>
                        <TextBlock Text="Free disk space on the system volume (GB)"
                                   FontWeight="SemiBold"
                                   FontSize="13" />
                        <TextBlock Text="{Binding DiskFreeValueText}"
                                   HorizontalAlignment="Right"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   Opacity="0.82" />
                      </Grid>
                      <infra:SparklineChart Height="52"
                                            AutoScaleToRange="True"
                                            Values="{Binding DiskFreeSeries}"
                                            LineBrush="{StaticResource ChartSpaceLineBrush}"
                                            AreaBrush="{StaticResource ChartSpaceAreaBrush}" />
                    </StackPanel>
                  </StackPanel>
                </Border>

                <!-- Free space per fixed volume. -->
                <Border Padding="12"
                        CornerRadius="14"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Disk space by volume"
                               FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding ResourceVolumes}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Margin="0,0,0,8"
                                      Spacing="2">
                            <TextBlock Text="{Binding HeadlineText}"
                                       FontWeight="SemiBold"
                                       FontSize="13" />
                            <ProgressBar Value="{Binding UsedPercent}"
                                         Maximum="100"
                                         Height="6" />
                            <TextBlock Text="{Binding DetailText}"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       Opacity="0.70" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <!-- Agent sessions: one row per developer process tree, expandable to its members. -->
                <Border Padding="12"
                        CornerRadius="14"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Agent sessions"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding AgentSessionSummaryText}"
                               FontFamily="Consolas"
                               FontSize="11"
                               Opacity="0.70" />
                    <ItemsControl ItemsSource="{Binding AgentSessions}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Margin="0,0,0,8"
                                  Padding="10"
                                  CornerRadius="10"
                                  Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                            <StackPanel Spacing="4">
                              <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="Auto" />
                                  <ColumnDefinition Width="*" />
                                  <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button Content="{Binding ExpandGlyph}"
                                        MinWidth="34"
                                        VerticalAlignment="Top"
                                        Tag="{Binding}"
                                        Click="ToggleAgentSession_Click" />

                                <StackPanel Grid.Column="1"
                                            Spacing="2">
                                  <TextBlock Text="{Binding HeadlineText}"
                                             FontWeight="SemiBold"
                                             FontSize="14"
                                             TextWrapping="WrapWholeWords" />
                                  <TextBlock Text="{Binding SubtitleText}"
                                             FontSize="12"
                                             Opacity="0.80"
                                             TextWrapping="WrapWholeWords" />
                                  <ProgressBar Value="{Binding SharePercent}"
                                               Maximum="100"
                                               Height="6" />
                                  <TextBlock Text="{Binding DetailText}"
                                             FontFamily="Consolas"
                                             FontSize="11"
                                             Opacity="0.70"
                                             TextWrapping="WrapWholeWords" />
                                  <TextBlock Text="{Binding WorkspaceText}"
                                             FontFamily="Consolas"
                                             FontSize="11"
                                             Opacity="0.55"
                                             TextWrapping="WrapWholeWords" />
                                </StackPanel>

                                <Button Grid.Column="2"
                                        Content="Kill Session"
                                        VerticalAlignment="Top"
                                        Tag="{Binding RootProcessId}"
                                        Click="KillProcess_Click" />
                              </Grid>

                              <ItemsControl ItemsSource="{Binding Members}"
                                            Margin="42,4,0,0"
                                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <Grid Margin="0,0,0,6"
                                          ColumnSpacing="10">
                                      <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                      </Grid.ColumnDefinitions>

                                      <StackPanel Spacing="1">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding DetailText}"
                                                   FontFamily="Consolas"
                                                   FontSize="10"
                                                   Opacity="0.65"
                                                   TextWrapping="WrapWholeWords" />
                                      </StackPanel>

                                      <Button Grid.Column="1"
                                              Content="Kill"
                                              VerticalAlignment="Top"
                                              Tag="{Binding ProcessId}"
                                              Click="KillProcess_Click" />
                                    </Grid>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <!-- Optimization findings derived from the sampled window. -->
                <Border Padding="12"
                        CornerRadius="14"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                  <StackPanel Spacing="8">
                    <TextBlock Text="What to fix"
                               FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding ResourceAdvice}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Margin="0,0,0,8"
                                  Padding="10"
                                  CornerRadius="10"
                                  Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                            <StackPanel Spacing="3">
                              <StackPanel Orientation="Horizontal"
                                          Spacing="8">
                                <Border Padding="6,1"
                                        CornerRadius="6"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                                  <TextBlock Text="{Binding SeverityLabel}"
                                             FontSize="10"
                                             FontWeight="Bold"
                                             Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>
                                <TextBlock Text="{Binding Title}"
                                           FontWeight="SemiBold"
                                           TextWrapping="WrapWholeWords"
                                           VerticalAlignment="Center" />
                              </StackPanel>
                              <TextBlock Text="{Binding Detail}"
                                         TextWrapping="WrapWholeWords"
                                         FontSize="12"
                                         Opacity="0.78" />
                              <TextBlock Text="{Binding Action}"
                                         TextWrapping="WrapWholeWords"
                                         FontSize="12"
                                         FontWeight="SemiBold"
                                         Opacity="0.92" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <!-- Where committed memory is going, grouped by kind of work. -->
                <Border Padding="12"
                        CornerRadius="14"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Where it is going (by workload)"
                               FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding ResourceWorkloads}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Margin="0,0,0,8"
                                      Spacing="2">
                            <TextBlock Text="{Binding HeadlineText}"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       TextWrapping="WrapWholeWords" />
                            <ProgressBar Value="{Binding SharePercent}"
                                         Maximum="100"
                                         Height="6" />
                            <TextBlock Text="{Binding DetailText}"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       Opacity="0.70"
                                       TextWrapping="WrapWholeWords" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <!-- Individual offenders, ranked by commit rather than working set. -->
                <Border Padding="12"
                        CornerRadius="14"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Top processes by committed memory"
                               FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding ResourceTopProcesses}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid Margin="0,0,0,8"
                                ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="2">
                              <TextBlock Text="{Binding Title}"
                                         FontWeight="SemiBold"
                                         FontSize="13" />
                              <ProgressBar Value="{Binding SharePercent}"
                                           Maximum="100"
                                           Height="6" />
                              <TextBlock Text="{Binding DetailText}"
                                         FontFamily="Consolas"
                                         FontSize="11"
                                         Opacity="0.70"
                                         TextWrapping="WrapWholeWords" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="Kill"
                                    VerticalAlignment="Top"
                                    Tag="{Binding ProcessId}"
                                    Click="KillProcess_Click" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Grid>
      </Border>

      <Border x:Name="RunDetailsBorder"
              Grid.Column="2"
              Padding="14"
              CornerRadius="18"
              HorizontalAlignment="Stretch"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1">
        <Grid RowSpacing="10">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="DetailsPane"
                        HorizontalAlignment="Stretch">
              <TextBlock Text="{Binding ContextPaneTitle}"
                         FontSize="20"
                         FontWeight="SemiBold" />
              <TextBlock Text="{Binding ContextPaneSubtitle}"
                         Opacity="0.72"
                         TextWrapping="WrapWholeWords" />
            </StackPanel>

            <Border x:Name="RunStatusBadge"
                    Grid.Column="1"
                    Padding="8,4"
                    CornerRadius="6"
                    VerticalAlignment="Top"
                    Background="{Binding SelectedRun.StatusForegroundBrush}">
              <TextBlock Text="{Binding SelectedRun.StatusBadgeText}"
                         Foreground="White"
                         FontWeight="SemiBold" />
            </Border>
          </Grid>

          <ScrollViewer x:Name="DetailsScroll"
                        Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="10"
                        HorizontalAlignment="Stretch">
              <StackPanel Spacing="4"
                          HorizontalAlignment="Stretch">
                <TextBlock Text="{Binding SelectedRun.WorkflowName}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           TextWrapping="WrapWholeWords" />
                <StackPanel Orientation="Horizontal"
                            Spacing="8">
                  <Border Padding="8,3"
                          CornerRadius="6"
                          Background="{Binding SelectedRun.WorkflowTagBackgroundBrush}">
                    <TextBlock Text="{Binding SelectedRun.WorkflowTagText}"
                               Foreground="{Binding SelectedRun.WorkflowTagForegroundBrush}"
                               FontSize="11"
                               FontWeight="SemiBold" />
                  </Border>
                  <Border Padding="8,3"
                          CornerRadius="6"
                          Background="{Binding SelectedRun.EventTagBackgroundBrush}">
                    <TextBlock Text="{Binding SelectedRun.EventTagText}"
                               Foreground="{Binding SelectedRun.EventTagForegroundBrush}"
                               FontSize="11"
                               FontWeight="SemiBold" />
                  </Border>
                </StackPanel>
                <TextBlock Text="{Binding SelectedRun.DisplayTitle}"
                           TextWrapping="WrapWholeWords" />
                <TextBlock Text="{Binding SelectedRun.WorkflowMetaSummary}"
                           Opacity="0.72" />
              </StackPanel>

              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Started:"
                           FontWeight="SemiBold" />
                <TextBlock Grid.Column="1"
                           Text="{Binding SelectedRun.CreatedAtDisplay}" />
                <TextBlock Grid.Column="2"
                           Text="Duration:"
                           Margin="16,0,0,0"
                           FontWeight="SemiBold" />
                <TextBlock Grid.Column="3"
                           Text="{Binding SelectedRun.DurationSummary}" />
              </Grid>

              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Displayed SHA:"
                           FontWeight="SemiBold" />
                <HyperlinkButton Grid.Column="1"
                                 Content="{Binding SelectedRun.UiShaDisplay}"
                                 Click="OpenLink_Click"
                                 Tag="{Binding SelectedRun.DisplayedCommitUrl}" />
                <TextBlock Grid.Column="2"
                           Text="Actual SHA:"
                           Margin="16,0,0,0"
                           FontWeight="SemiBold" />
                <HyperlinkButton Grid.Column="3"
                                 Content="{Binding SelectedRun.ActualShaDisplay}"
                                 Click="OpenLink_Click"
                                 Tag="{Binding SelectedRun.ActualCommitUrl}"
                                 IsEnabled="{Binding SelectedRun.HasActualCommitUrl}" />
              </Grid>

              <Expander x:Name="TriggerDetailsExpander"
                        Header="Trigger Details"
                        IsExpanded="False">
                <Grid ColumnSpacing="18"
                      HorizontalAlignment="Stretch"
                      Margin="0,8,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <StackPanel Spacing="6">
                    <TextBlock Text="Displayed By GitHub UI"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SelectedRun.UiSummary}" />
                    <TextBlock Text="{Binding SelectedRun.StatusSummary}" />
                    <TextBlock Text="{Binding SelectedRun.TriggerExplanation}"
                               TextWrapping="WrapWholeWords"
                               Opacity="0.78" />
                  </StackPanel>

                  <StackPanel Grid.Column="1"
                              Spacing="6">
                    <TextBlock Text="Resolved Trigger"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SelectedRun.ActualSummary}" />
                    <TextBlock Text="{Binding SelectedRun.PullRequestSummary}"
                               TextWrapping="WrapWholeWords" />
                    <TextBlock Text="{Binding SelectedRun.UpstreamRunSummary}"
                               TextWrapping="WrapWholeWords" />
                    <TextBlock Text="{Binding SelectedRun.ResolutionError}"
                               Foreground="IndianRed"
                               TextWrapping="WrapWholeWords" />
                  </StackPanel>
                </Grid>
              </Expander>

              <Expander x:Name="PullRequestDescriptionExpander"
                        Header="{Binding SelectedRun.RunDescriptionHeader}"
                        IsExpanded="False">
                <Border Padding="12"
                        Margin="0,8,0,0"
                        CornerRadius="14"
                        HorizontalAlignment="Stretch"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                  <TextBlock Text="{Binding SelectedRun.RunDescription}"
                             TextWrapping="WrapWholeWords" />
                </Border>
              </Expander>

              <Expander Header="Links"
                        IsExpanded="False">
                <Grid Margin="0,8,0,0"
                       ColumnSpacing="8"
                       HorizontalAlignment="Stretch"
                       RowSpacing="8">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <Button Grid.Row="0"
                          Grid.Column="0"
                          Content="Run"
                          Click="OpenLink_Click"
                          Tag="{Binding SelectedRun.RunUrl}" />
                  <Button Grid.Row="0"
                          Grid.Column="1"
                          Content="Displayed Commit"
                          Click="OpenLink_Click"
                          Tag="{Binding SelectedRun.DisplayedCommitUrl}" />
                  <Button Grid.Row="0"
                          Grid.Column="2"
                          Content="Actual Commit"
                          Click="OpenLink_Click"
                          Tag="{Binding SelectedRun.ActualCommitUrl}"
                          IsEnabled="{Binding SelectedRun.HasActualCommitUrl}" />
                  <Button Grid.Row="1"
                          Grid.Column="0"
                          Content="Pull Request"
                          Click="OpenLink_Click"
                          Tag="{Binding SelectedRun.PullRequestUrl}"
                          IsEnabled="{Binding SelectedRun.HasPullRequestUrl}" />
                  <Button Grid.Row="1"
                          Grid.Column="1"
                          Content="Upstream Run"
                          Click="OpenLink_Click"
                          Tag="{Binding SelectedRun.UpstreamRunUrl}"
                          IsEnabled="{Binding SelectedRun.HasUpstreamRunUrl}" />
                  <Button Grid.Row="1"
                          Grid.Column="2"
                          Content="Set Branch Job"
                          Click="OpenLink_Click"
                          Tag="{Binding SelectedRun.SetBranchJobUrl}"
                          IsEnabled="{Binding SelectedRun.HasSetBranchJobUrl}" />
                  <Button Grid.Row="2"
                          Grid.Column="0"
                          Content="Detection Job"
                          Click="OpenLink_Click"
                          Tag="{Binding SelectedRun.DetectJobUrl}"
                          IsEnabled="{Binding SelectedRun.HasDetectJobUrl}" />
                </Grid>
              </Expander>
            </StackPanel>
          </ScrollViewer>

          <!-- Context for the Resources tab: what this machine is, and what is currently worst on it. -->
          <ScrollViewer x:Name="SystemOverviewScroll"
                        Grid.Row="1"
                        Visibility="Collapsed"
                        HorizontalAlignment="Stretch"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="10"
                        HorizontalAlignment="Stretch">

              <Border Style="{StaticResource ContextCardStyle}">
                <StackPanel>
                  <TextBlock Text="This machine"
                             Style="{StaticResource ContextCardHeaderStyle}" />
                  <TextBlock Text="{Binding MachineSpecText}"
                             TextWrapping="WrapWholeWords"
                             FontFamily="Consolas"
                             FontSize="12"
                             Opacity="0.82" />
                </StackPanel>
              </Border>

              <Border Style="{StaticResource ContextCardStyle}">
                <StackPanel>
                  <TextBlock Text="Current bottleneck"
                             Style="{StaticResource ContextCardHeaderStyle}" />
                  <TextBlock Text="{Binding ResourceVerdictText}"
                             TextWrapping="WrapWholeWords"
                             Opacity="0.88" />
                </StackPanel>
              </Border>

              <Border Style="{StaticResource ContextCardStyle}">
                <StackPanel>
                  <TextBlock Text="Memory budget"
                             Style="{StaticResource ContextCardHeaderStyle}" />
                  <StackPanel Spacing="6">
                    <TextBlock Text="Committed"
                               FontSize="12"
                               Opacity="0.7" />
                    <ProgressBar Value="{Binding CommitPercentValue}"
                                 Maximum="100"
                                 Height="6" />
                    <TextBlock Text="{Binding CommitValueText}"
                               FontFamily="Consolas"
                               FontSize="11"
                               Opacity="0.78"
                               TextWrapping="WrapWholeWords" />

                    <TextBlock Text="Physical RAM"
                               FontSize="12"
                               Opacity="0.7"
                               Margin="0,6,0,0" />
                    <ProgressBar Value="{Binding MemoryPercentValue}"
                                 Maximum="100"
                                 Height="6" />
                    <TextBlock Text="{Binding MemoryValueText}"
                               FontFamily="Consolas"
                               FontSize="11"
                               Opacity="0.78"
                               TextWrapping="WrapWholeWords" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource ContextCardStyle}">
                <StackPanel>
                  <TextBlock Text="Heaviest sessions"
                             Style="{StaticResource ContextCardHeaderStyle}" />
                  <ItemsControl ItemsSource="{Binding TopAgentSessions}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Margin="0,0,0,10"
                                    Spacing="2">
                          <TextBlock Text="{Binding HeadlineText}"
                                     FontSize="12"
                                     FontWeight="SemiBold"
                                     TextWrapping="WrapWholeWords" />
                          <TextBlock Text="{Binding SubtitleText}"
                                     FontSize="11"
                                     Opacity="0.75"
                                     TextWrapping="WrapWholeWords" />
                          <ProgressBar Value="{Binding SharePercent}"
                                       Maximum="100"
                                       Height="5" />
                          <TextBlock Text="{Binding DetailText}"
                                     FontFamily="Consolas"
                                     FontSize="10"
                                     Opacity="0.65"
                                     TextWrapping="WrapWholeWords" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Page>
